<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Display</RootNamespace>
    <PackageId>Klyroo.Display</PackageId>
    <PackageTags>klyroo;blazor;display;audio-player;video-player;file-preview;syntax-highlighting;maui</PackageTags>
    <Description>Klyroo Display blocks (19 kinds), Audio/Video players with clip rules, and FilePreview overlay provider for Blazor Web &amp; .NET MAUI Hybrid.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);BL0007</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Klyroo.Display.Core\Klyroo.Display.Core.csproj" />
    <ProjectReference Include="..\..\..\klyroo-ui\src\Klyroo.UI\Klyroo.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <SupportedPlatform Include="ios" />
    <SupportedPlatform Include="android" />
    <SupportedPlatform Include="maccatalyst" />
    <SupportedPlatform Include="windows" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Klyroo.UI" />
  </ItemGroup>
</Project>
