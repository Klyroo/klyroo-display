@namespace Klyroo.Display
@using Microsoft.JSInterop
@inherits KlyComponentBase

<div class="@_slots["root"]" data-slot="secret-block" @attributes="AdditionalAttributes">
    <div class="@_slots["header"]" data-slot="code-header">
        <span class="@_slots["label"]" data-slot="code-label">@(Label ?? Texts.Secret)</span>
        <div class="@_slots["actions"]">
            <button type="button" class="@_slots["toggle"]" aria-pressed="@(_revealed ? "true" : "false")" data-slot="code-secret-toggle" @onclick="Toggle">
                @RenderIcon(_revealed ? "eye-off" : "eye", _slots["toggleIcon"])
                <span>@(_revealed ? Texts.Conceal : Texts.Reveal)</span>
            </button>
            @if (Copy)
            {
                <button type="button" class="@_slots["copy"]" aria-label="@Texts.CopyCode" data-slot="code-copy" @onclick="CopyAsync">
                    @RenderIcon("copy", _slots["copyIcon"])
                </button>
            }
        </div>
    </div>
    <pre class="@_slots["pre"]" data-slot="code-value"><code>@(_revealed ? Value ?? "" : Mask(Value ?? "", VisibleChars))</code></pre>
</div>

@code {
    private SlotSet _slots = default!;
    private bool _revealed;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>The secret, such as an API key or a token. While it is masked it is not written to the page at all, only its last <see cref="VisibleChars"/> characters are.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>The label above the value. Without it, the localized "Secret".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// The number of trailing characters left visible while the value is masked (<c>4</c> by default). A longer value shows eight bullets followed by those characters.
    /// A value that is not longer than this number is fully masked, so a short secret is never shown whole.
    /// </summary>
    [Parameter] public int VisibleChars { get; set; } = 4;

    /// <summary>Whether the block shows a copy button, which copies the whole secret even while it is masked (<see langword="true"/> by default). The Reveal and copy buttons need an interactive render mode.</summary>
    [Parameter] public bool Copy { get; set; } = true;

    /// <summary>Per-instance class overrides of the slots of the block, see <see cref="SecretBlockUi"/>. They are merged after the theme, and <c>Class</c> wins on the root slot.</summary>
    [Parameter] public SecretBlockUi? Ui { get; set; }

    private DisplayTexts Texts => Options.Extension<KlyrooDisplayOptions>().ResolveTexts(CurrentLocale.Code);

    /// <inheritdoc />
    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Extension<KlyrooDisplayOptions>().SecretBlock, new Dictionary<string, string?>(), Ui, "root");

    private void Toggle() => _revealed = !_revealed;

    private Task CopyAsync() => ClipboardCopy.WriteAsync(JS, RendererInfo.IsInteractive, Value);

    private static string Mask(string raw, int visible)
    {
        if (string.IsNullOrEmpty(raw)) return "••••••••";
        if (visible <= 0 || raw.Length <= visible) return new string('•', Math.Max(8, raw.Length));
        return new string('•', 8) + raw[^visible..];
    }
}
