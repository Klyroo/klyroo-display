@namespace Klyroo.Display
@inherits KlyComponentBase
@using System.Globalization
@using Microsoft.JSInterop

@*
    Read-only display block component supporting 19 structured display block kinds:
    Heading, Text, Alert, Facts, Stat, Breakdown, Meter, Chart, Table, Diff, Record, Person,
    List, Timeline, Date, Media, Code, Empty and Accordion.
*@
<div class="@RootClass()" data-slot="display" data-kind="@KindKey" data-surface="@SurfaceKey" data-loading="@(Loading ? "true" : null)" @attributes="AdditionalAttributes">
    @if (Loading)
    {
        @RenderSkeleton()
    }
    else
    {
        @switch (Kind)
        {
            case DisplayKind.Heading:
                @RenderHeading()
                break;
            case DisplayKind.Text:
                @RenderText()
                break;
            case DisplayKind.Alert:
                @RenderAlert()
                break;
            case DisplayKind.Facts:
                @RenderFacts()
                break;
            case DisplayKind.Stat:
                @RenderStat()
                break;
            case DisplayKind.Breakdown:
                @RenderBreakdown()
                break;
            case DisplayKind.Meter:
                @RenderMeter()
                break;
            case DisplayKind.Chart:
                @RenderChart()
                break;
            case DisplayKind.Table:
                @RenderTable()
                break;
            case DisplayKind.Diff:
                @RenderDiff()
                break;
            case DisplayKind.Record:
                @RenderRecord()
                break;
            case DisplayKind.Person:
                @RenderPerson()
                break;
            case DisplayKind.List:
                @RenderList()
                break;
            case DisplayKind.Timeline:
                @RenderTimeline()
                break;
            case DisplayKind.Date:
                @RenderDate()
                break;
            case DisplayKind.Media:
                @RenderMedia()
                break;
            case DisplayKind.Code:
                @RenderCode()
                break;
            case DisplayKind.Empty:
                @RenderEmpty()
                break;
            case DisplayKind.Accordion:
                @RenderAccordion()
                break;
        }
    }
</div>

@code {
    private bool _detailsOpen;
    private bool _detailsInitialized;
    private bool _secretRevealed;
    private bool _textExpanded;
    private int _revealedCount;
    private readonly HashSet<int> _openAccordionIndices = [];
    private bool _accordionInitialized;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>The kind of block to render (<see cref="DisplayKind.Facts"/> by default).</summary>
    [Parameter] public DisplayKind Kind { get; set; } = DisplayKind.Facts;

    /// <summary>Selects a variant of the kind. Matching is case-insensitive and an unknown value renders the default layout. Heading: <c>eyebrow</c>. Text: <c>quote</c>. Stat: <c>row</c>. Breakdown: <c>collapsible</c>. Meter: <c>ring</c>, <c>scale</c>. Chart: <c>line</c>, <c>funnel</c>. Table: <c>sticky</c>. Person: <c>group</c>. List: <c>steps</c>, <c>checks</c>, <c>files</c>. Timeline: <c>pipeline</c>, <c>log</c>, <c>schedule</c>. Date: <c>countdown</c>, <c>range</c>. Media: <c>gallery</c>. Code: <c>secret</c>.</summary>
    [Parameter] public string? Variant { get; set; }

    /// <summary>The surface treatment (<see cref="DisplaySurface.Plain"/>, <see cref="DisplaySurface.Muted"/>, <see cref="DisplaySurface.Bordered"/> or <see cref="DisplaySurface.Elevated"/>). When <see langword="null"/>, a default is chosen from <see cref="Kind"/>: bordered for Facts, Breakdown, Table, Record and Code, muted for Alert and Stat (Stat is bordered for its <c>row</c> variant, and muted for any other variant), and plain for the others.</summary>
    [Parameter] public DisplaySurface? Surface { get; set; }

    /// <summary>The tone of the block. Only <see cref="DisplayKind.Alert"/> reads it: it selects the default icon and sets <c>role="status"</c> for <see cref="KlyColor.Warning"/> and <see cref="KlyColor.Error"/>. Items have their own <c>Tone</c>.</summary>
    [Parameter] public KlyColor Tone { get; set; } = KlyColor.Primary;

    /// <summary>Shows a skeleton placeholder instead of the block.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The title of the block: the heading text, the bold first line of a Text, the Alert title, the label of a Stat, Meter or Code block, the line above a <c>row</c> Stat, and the title of the other kinds that show one. For a Person block it is the name of the single person when <see cref="People"/> is empty (no name is shown when it is not set either), or the caption of a <c>group</c>. For a Date block it replaces the formatted date, or is a caption under the <c>countdown</c> and <c>range</c> text, and for a Media block it is the alt text.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The main text of the block: the Text body, the Alert message, the Stat value, the Meter value label, or the Code content.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>A secondary line: under the title of a Heading, Stat, Meter, Date, Media (caption) or Empty block, under the name of a single Person when <see cref="People"/> is empty, or the Alert message when <see cref="Value"/> is empty.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>The unit shown beside a Stat value, or at the end of a Chart title.</summary>
    [Parameter] public string? Unit { get; set; }

    /// <summary>The name of the leading icon of a Heading, Alert or Empty block. For an Alert, an empty string hides the icon.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>The level of the heading element of a Heading block, from <c>1</c> (<c>h1</c>) to <c>6</c> (<c>h6</c>); <c>3</c> by default, and values outside are clamped. Choose it from the page outline: the look does not change with the level. The <c>eyebrow</c> variant renders no heading element.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;

    /// <summary>Count text shown beside the title of a Heading or Record block.</summary>
    [Parameter] public string? Count { get; set; }

    /// <summary>The badge of the single person shown by a Person block when <see cref="People"/> is empty.</summary>
    [Parameter] public DisplayChip? Chip { get; set; }

    /// <summary>The button of a Heading block, shown at the end of the row.</summary>
    [Parameter] public DisplayAction? Action { get; set; }

    /// <summary>The buttons of an Alert or Empty block.</summary>
    [Parameter] public IReadOnlyList<DisplayAction>? Actions { get; set; }

    /// <summary>The paragraphs of a Text block. When set, they replace <see cref="Value"/>.</summary>
    [Parameter] public IReadOnlyList<string>? Paragraphs { get; set; }

    /// <summary>The author shown in the footer of a Text block, before <see cref="Meta"/>.</summary>
    [Parameter] public string? Author { get; set; }

    /// <summary>Extra text shown in the footer of a Text block, after <see cref="Author"/>.</summary>
    [Parameter] public string? Meta { get; set; }

    /// <summary>When greater than zero, clamps <see cref="Value"/> of a Text block to this number of lines and adds a Read more toggle. The toggle shows even when the text is shorter, and <see cref="Paragraphs"/> are not clamped.</summary>
    [Parameter] public int? MaxLines { get; set; }

    /// <summary>The collapsible details of an Alert (opened with Show details), or the footnote of a Breakdown.</summary>
    [Parameter] public string? Details { get; set; }

    /// <summary>Whether the Alert details, or the lines of a <c>collapsible</c> Breakdown, start open. It is read once, when the component first receives its parameters.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>The rows of a Facts block. They are ignored when <see cref="FactGroups"/> is set.</summary>
    [Parameter] public IReadOnlyList<DisplayFact>? Facts { get; set; }

    /// <summary>The titled groups of a Facts block. When set, they replace <see cref="Facts"/>, and <see cref="Max"/> does not apply.</summary>
    [Parameter] public IReadOnlyList<DisplayFactGroup>? FactGroups { get; set; }

    /// <summary>The change shown as a badge beside a Stat value, for example <c>"+12.4%"</c>. It is displayed as given.</summary>
    [Parameter] public string? Delta { get; set; }

    /// <summary>The direction of <see cref="Delta"/>: <c>"up"</c> (green, the default), <c>"down"</c> (red) or <c>"flat"</c> (neutral).</summary>
    [Parameter] public string DeltaDirection { get; set; } = "up";

    /// <summary>The series of a Stat sparkline. It is drawn from two points or more.</summary>
    [Parameter] public IReadOnlyList<double>? Trend { get; set; }

    /// <summary>The metrics of a Stat block with <c>Variant="row"</c>. That variant shows <see cref="Title"/> above them and ignores <see cref="Value"/>, <see cref="Unit"/>, <see cref="Delta"/>, <see cref="Trend"/> and <see cref="Description"/>.</summary>
    [Parameter] public IReadOnlyList<DisplayStatItem>? StatItems { get; set; }

    /// <summary>The lines of a Breakdown block.</summary>
    [Parameter] public IReadOnlyList<DisplayBreakdownLine>? BreakdownLines { get; set; }

    /// <summary>The total row of a Breakdown block, shown below the lines.</summary>
    [Parameter] public DisplayBreakdownLine? BreakdownTotal { get; set; }

    /// <summary>The headers of the two amount columns of a Breakdown, for example <c>("2026", "2025")</c>: <see cref="DisplayBreakdownLine.Value"/> goes under <c>First</c> and <see cref="DisplayBreakdownLine.CompareValue"/> under <c>Second</c>, for the lines and the total. A line without a second amount shows a dash.</summary>
    [Parameter] public (string First, string Second)? CompareColumns { get; set; }

    /// <summary>The current value of a Meter block, clamped between 0 and <see cref="MeterMax"/>.</summary>
    [Parameter] public double MeterValue { get; set; }

    /// <summary>The maximum of a Meter block (<c>100</c> by default). When it is zero or less, the sum of <see cref="MeterParts"/> is used.</summary>
    [Parameter] public double MeterMax { get; set; } = 100;

    /// <summary>The percentage of <see cref="MeterMax"/> from which the Meter bar turns to the warning color.</summary>
    [Parameter] public double? WarningThreshold { get; set; }

    /// <summary>The percentage of <see cref="MeterMax"/> from which the Meter bar turns to the error color. It wins over <see cref="WarningThreshold"/>.</summary>
    [Parameter] public double? ErrorThreshold { get; set; }

    /// <summary>The segments of a Meter block, stacked in the bar or around the ring. When set, they replace the single value and the thresholds do not apply. A legend lists them when one of them has a <see cref="DisplayMeterPart.ValueLabel"/>, an <see cref="DisplayMeterPart.Icon"/> or a <see cref="DisplayMeterPart.Max"/>.</summary>
    [Parameter] public IReadOnlyList<DisplayMeterPart>? MeterParts { get; set; }

    /// <summary>The level labels of a Meter block with <c>Variant="scale"</c>.</summary>
    [Parameter] public IReadOnlyList<string>? MeterLevels { get; set; }

    /// <summary>The zero-based index of the current level of a <c>scale</c> Meter. The levels up to it are highlighted.</summary>
    [Parameter] public int? CurrentLevel { get; set; }

    /// <summary>The bars of a Chart block, the points of a <c>line</c> Chart, or the steps of a <c>funnel</c> Chart.</summary>
    [Parameter] public IReadOnlyList<DisplayChartPoint>? ChartData { get; set; }

    /// <summary>The columns of a Table block.</summary>
    [Parameter] public IReadOnlyList<DisplayTableColumn>? TableColumns { get; set; }

    /// <summary>The rows of a Table block. Each row maps a column key to its text, and a missing key renders a dash.</summary>
    [Parameter] public IReadOnlyList<IReadOnlyDictionary<string, string?>>? TableRows { get; set; }

    /// <summary>The footer row of a Table block, as a map from column key to text.</summary>
    [Parameter] public IReadOnlyDictionary<string, string?>? TableFooter { get; set; }

    /// <summary>The fields of a Diff block.</summary>
    [Parameter] public IReadOnlyList<DisplayDiffItem>? DiffItems { get; set; }

    /// <summary>Shows the fields whose <see cref="DisplayDiffItem.Changed"/> is <see langword="false"/> (<see langword="false"/> by default).</summary>
    [Parameter] public bool ShowUnchanged { get; set; }

    /// <summary>The rows of a Record block.</summary>
    [Parameter] public IReadOnlyList<DisplayRecordItem>? Records { get; set; }

    /// <summary>The people of a Person block. Without the <c>group</c> variant, only the first person is shown. When empty, the person comes from <see cref="Title"/>, <see cref="Description"/> and <see cref="Chip"/>, and the avatar shows a person icon when there is no name.</summary>
    [Parameter] public IReadOnlyList<DisplayPersonItem>? People { get; set; }

    /// <summary>The contact lines of a Person block. They are shown under the person and are ignored by the <c>group</c> variant.</summary>
    [Parameter] public IReadOnlyList<DisplayContactItem>? Contacts { get; set; }

    /// <summary>The items of a List block.</summary>
    [Parameter] public IReadOnlyList<DisplayListItem>? ListItems { get; set; }

    /// <summary>The events of a Timeline block.</summary>
    [Parameter] public IReadOnlyList<DisplayTimelineItem>? TimelineItems { get; set; }

    /// <summary>The date of a Date block, or the start of a <c>range</c>. When <see langword="null"/>, the current date is used.</summary>
    [Parameter] public DateTimeOffset? DateValue { get; set; }

    /// <summary>The end of a <c>range</c> Date block, inclusive in the day count.</summary>
    [Parameter] public DateTimeOffset? EndDateValue { get; set; }

    /// <summary>The reference time of a <c>countdown</c> Date block. When <see langword="null"/>, <see cref="DateTimeOffset.UtcNow"/> is used. Pass it for tests and for stable server rendering.</summary>
    [Parameter] public DateTimeOffset? Now { get; set; }

    /// <summary>The language of a Code block: it selects the syntax highlighting, and it is the label of the block when <see cref="Title"/> is not set. It accepts a name, an alias or a file extension (<c>csharp</c>, <c>cs</c>, <c>ts</c>, <c>json</c>, <c>html</c>, <c>xml</c>, <c>css</c>, <c>scss</c>, <c>less</c>, <c>sql</c>, <c>python</c>, <c>bash</c>, <c>yaml</c> and the others <see cref="CodeHighlighter.Languages"/> lists). A language that is not supported, or none, renders plain text. A <c>secret</c> block is never highlighted.</summary>
    [Parameter] public string? Language { get; set; }

    /// <summary>Whether a Code block is highlighted according to <see cref="Language"/> (<see langword="true"/> by default). Set it to <see langword="false"/> to render plain text. A code longer than <see cref="CodeHighlighter.MaxLength"/> characters or <see cref="CodeHighlighter.MaxLines"/> lines is never highlighted.</summary>
    [Parameter] public bool Highlight { get; set; } = true;

    /// <summary>The number of trailing characters left visible by a <c>secret</c> Code block (<c>4</c> by default). A longer value shows eight bullets followed by those characters. A value that is not longer than this number is fully masked.</summary>
    [Parameter] public int VisibleChars { get; set; } = 4;

    /// <summary>Whether a Code block shows a copy button (<see langword="true"/> by default).</summary>
    [Parameter] public bool Copy { get; set; } = true;

    /// <summary>The sections of an Accordion block.</summary>
    [Parameter] public IReadOnlyList<DisplayAccordionItem>? AccordionItems { get; set; }

    /// <summary>Allows several Accordion sections to be open at once (<see langword="false"/> by default).</summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>The image URL of a Media block.</summary>
    [Parameter] public string? Src { get; set; }

    /// <summary>The image URLs of a Media block with <c>Variant="gallery"</c>.</summary>
    [Parameter] public IReadOnlyList<string>? Images { get; set; }

    /// <summary>The number of items shown before a Show more button, for the flat Facts, Table, Record, List and Timeline kinds (all items when <see langword="null"/>). In a <c>group</c> Person block it is the number of avatars (4 by default), and in a <c>gallery</c> Media block the number of tiles (3 by default).</summary>
    [Parameter] public int? Max { get; set; }

    /// <summary>The number of items each click on Show more reveals (all remaining items when <see langword="null"/>).</summary>
    [Parameter] public int? Step { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!_detailsInitialized)
        {
            _detailsInitialized = true;
            _detailsOpen = DefaultOpen;
        }
        if (Max is { } m && _revealedCount < m)
        {
            _revealedCount = m;
        }
        if (!_accordionInitialized && AccordionItems is { Count: > 0 })
        {
            _accordionInitialized = true;
            for (var i = 0; i < AccordionItems.Count; i++)
            {
                if (AccordionItems[i].DefaultOpen)
                {
                    _openAccordionIndices.Add(i);
                    if (!Multiple) break;
                }
            }
        }
    }

    // The texts of the current locale, the one the Messages of Klyroo.UI come from; cached per locale by the options.
    private DisplayTexts Texts => Options.Extension<KlyrooDisplayOptions>().ResolveTexts(CurrentLocale.Code);

    // The data-color attribute of a tone: the Klyroo.UI theme sets --kly-color and --kly-color-text from it, for built-in and custom colors.
    private static string? ToneValue(KlyColor? tone) => tone?.Value;

    private RenderFragment RenderChip(DisplayChip chip) =>
        @<KlyBadge Label="@chip.Label" Color="@(chip.Color ?? KlyColor.Neutral)" Variant="KlyVariant.Subtle" Size="KlySize.Sm"
                  LeadingIcon="@(string.IsNullOrEmpty(chip.Icon) ? null : RenderIcon(chip.Icon, "size-3"))" data-slot="display-chip" />;

    private RenderFragment RenderHeadingTitle() => builder =>
    {
        builder.OpenElement(0, $"h{Math.Clamp(HeadingLevel, 1, 6)}");
        builder.AddAttribute(1, "class", "m-0 truncate text-base font-semibold text-(--klyroo-text-highlighted)");
        builder.AddAttribute(2, "data-slot", "heading-title");
        builder.AddContent(3, Title);
        builder.CloseElement();
    };

    private string KindKey => Kind.ToString().ToLowerInvariant();

    private DisplaySurface EffectiveSurface => Surface ?? Kind switch
    {
        DisplayKind.Facts or DisplayKind.Breakdown or DisplayKind.Table or DisplayKind.Record or DisplayKind.Code => DisplaySurface.Bordered,
        DisplayKind.Stat => string.Equals(Variant, "row", StringComparison.OrdinalIgnoreCase) ? DisplaySurface.Bordered : DisplaySurface.Muted,
        DisplayKind.Alert => DisplaySurface.Muted,
        _ => DisplaySurface.Plain,
    };

    private string SurfaceKey => EffectiveSurface.ToString().ToLowerInvariant();

    private string RootClass()
    {
        var surfaceClass = EffectiveSurface switch
        {
            DisplaySurface.Muted => "rounded-(--klyroo-radius) bg-(--klyroo-bg-muted) p-4",
            DisplaySurface.Bordered => "rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) p-4",
            DisplaySurface.Elevated => "rounded-(--klyroo-radius) border border-(--klyroo-border-accented) bg-(--klyroo-bg-elevated) p-4 shadow-sm",
            _ => "",
        };
        return $"flex w-full min-w-0 flex-col gap-3 text-sm text-(--klyroo-text) {surfaceClass} {Class}".Trim();
    }

    private (IReadOnlyList<T> Visible, int Remaining) ApplyReveal<T>(IReadOnlyList<T>? source)
    {
        if (source is null || source.Count == 0) return ([], 0);
        if (Max is not { } max || max <= 0) return (source, 0);
        var limit = Math.Max(max, _revealedCount);
        if (source.Count <= limit) return (source, 0);
        var nextBatch = Step is > 0 ? Math.Min(Step.Value, source.Count - limit) : source.Count - limit;
        return (source.Take(limit).ToList(), nextBatch);
    }

    private void RevealMore(int totalCount)
    {
        var current = Math.Max(Max ?? 0, _revealedCount);
        _revealedCount = Step is > 0 ? Math.Min(totalCount, current + Step.Value) : totalCount;
    }

    private RenderFragment RenderRevealButton(int nextCount, int totalCount) =>
        @<button type="button" class="inline-flex items-center gap-1.5 self-start rounded-(--klyroo-radius) px-2 py-1 text-xs font-medium text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text) focus-visible:outline-2 focus-visible:outline-(--klyroo-primary-text)"
                 data-slot="display-more" @onclick="@(() => RevealMore(totalCount))">
            <span>@Texts.ShowMore(nextCount)</span>
            @RenderIcon("chevron-down", "size-3.5")
        </button>;

    private async Task CopyToClipboardAsync(string? text)
    {
        if (string.IsNullOrEmpty(text) || !RendererInfo.IsInteractive) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException)
        {
        }
    }

    private RenderFragment RenderSkeleton() =>
        @<div class="flex flex-col gap-2.5" data-slot="display-skeleton" aria-busy="true">
            <KlySkeleton Class="h-5 w-1/3" />
            <KlySkeleton Class="h-4 w-2/3" />
            <KlySkeleton Class="h-4 w-1/2" />
        </div>;

    private RenderFragment RenderHeading() =>
        @<div class="flex flex-wrap items-center justify-between gap-2" data-slot="display-heading">
            <div class="flex min-w-0 items-center gap-2.5">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-(--klyroo-radius) bg-(--klyroo-bg-muted) text-(--klyroo-primary-text)">
                        @RenderIcon(Icon, "size-4")
                    </span>
                }
                <div class="flex min-w-0 flex-col gap-0.5">
                    <div class="flex items-center gap-2">
                        @if (string.Equals(Variant, "eyebrow", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="text-xs font-semibold tracking-wider uppercase text-(--klyroo-text-muted)" data-slot="heading-title">@Title</span>
                        }
                        else
                        {
                            @RenderHeadingTitle()
                        }
                        @if (!string.IsNullOrEmpty(Count))
                        {
                            <span class="inline-flex items-center rounded-full border border-(--klyroo-border-accented) px-2 py-0.5 text-xs font-medium tabular-nums text-(--klyroo-text-muted)" data-slot="heading-count">@Count</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Description))
                    {
                        <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="heading-description">@Description</p>
                    }
                </div>
            </div>
            @if (Action is not null)
            {
                @RenderAction(Action)
            }
        </div>;

    private RenderFragment RenderText() =>
        @<div class="@(string.Equals(Variant, "quote", StringComparison.OrdinalIgnoreCase) ? "border-s-2 border-(--klyroo-primary-text) ps-3 italic" : "flex flex-col gap-2")" data-slot="display-text">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="m-0 font-semibold text-(--klyroo-text-highlighted)">@Title</p>
            }
            @if (Paragraphs is { Count: > 0 })
            {
                @foreach (var p in Paragraphs)
                {
                    <p class="m-0 text-(--klyroo-text)">@p</p>
                }
            }
            else if (!string.IsNullOrEmpty(Value))
            {
                <p class="m-0 @(MaxLines is > 0 && !_textExpanded ? "line-clamp-2" : "")" style="@(MaxLines is > 0 && !_textExpanded ? $"-webkit-line-clamp:{MaxLines}" : null)" data-slot="text-body">@Value</p>
            }
            @if (MaxLines is > 0)
            {
                <button type="button" class="self-start text-xs font-medium text-(--klyroo-primary-text) hover:underline"
                        data-slot="text-toggle" @onclick="@(() => _textExpanded = !_textExpanded)">
                    @(_textExpanded ? Texts.ShowLess : Texts.ReadMore)
                </button>
            }
            @if (!string.IsNullOrEmpty(Author) || !string.IsNullOrEmpty(Meta))
            {
                <footer class="text-xs not-italic text-(--klyroo-text-muted)">
                    @string.Join(" · ", new[] { Author, Meta }.Where(s => !string.IsNullOrWhiteSpace(s)))
                </footer>
            }
        </div>;

    private RenderFragment RenderAlert() =>
        @<div class="flex items-start gap-3" role="@(Tone == KlyColor.Error || Tone == KlyColor.Warning ? "status" : null)" data-slot="display-alert">
            @if (Icon != "")
            {
                var iconName = !string.IsNullOrEmpty(Icon) ? Icon
                    : Tone == KlyColor.Success ? "circle-check"
                    : Tone == KlyColor.Warning ? "triangle-alert"
                    : Tone == KlyColor.Error ? "circle-x"
                    : "info";
                <span class="mt-0.5 shrink-0 text-(--klyroo-text-highlighted)">@RenderIcon(iconName, "size-4")</span>
            }
            <div class="flex min-w-0 flex-1 flex-col gap-1.5">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <p class="m-0 font-semibold text-(--klyroo-text-highlighted)" data-slot="alert-title">@Title</p>
                }
                @if (!string.IsNullOrEmpty(Value) || !string.IsNullOrEmpty(Description))
                {
                    <p class="m-0 text-(--klyroo-text-muted)" data-slot="alert-message">@(!string.IsNullOrEmpty(Value) ? Value : Description)</p>
                }
                @if (!string.IsNullOrEmpty(Details))
                {
                    <button type="button" class="inline-flex items-center gap-1 self-start text-xs font-medium text-(--klyroo-text-highlighted) hover:underline"
                            aria-expanded="@(_detailsOpen ? "true" : "false")" data-slot="alert-details-toggle"
                            @onclick="@(() => _detailsOpen = !_detailsOpen)">
                        <span>@(_detailsOpen ? Texts.HideDetails : Texts.ShowDetails)</span>
                        @RenderIcon(_detailsOpen ? "chevron-up" : "chevron-down", "size-3.5")
                    </button>
                    @if (_detailsOpen)
                    {
                        <div class="rounded-(--klyroo-radius) bg-(--klyroo-bg) p-2.5 text-xs text-(--klyroo-text-muted)" data-slot="alert-details">@Details</div>
                    }
                }
                @if (Actions is { Count: > 0 })
                {
                    <div class="mt-1 flex flex-wrap items-center gap-2">
                        @foreach (var act in Actions)
                        {
                            @RenderAction(act)
                        }
                    </div>
                }
            </div>
        </div>;

    private RenderFragment RenderFacts() =>
        @<div class="flex flex-col gap-3" data-slot="display-facts">
            @if (FactGroups is { Count: > 0 })
            {
                @foreach (var grp in FactGroups)
                {
                    <div class="flex flex-col gap-2" data-slot="fact-group">
                        @if (!string.IsNullOrEmpty(grp.Title) || !string.IsNullOrEmpty(grp.Aside))
                        {
                            <div class="flex items-center justify-between gap-2 border-b border-(--klyroo-border) pb-1">
                                <span class="text-xs font-semibold text-(--klyroo-text-highlighted)">@grp.Title</span>
                                @if (!string.IsNullOrEmpty(grp.Aside))
                                {
                                    <span class="text-xs text-(--klyroo-text-muted)">@grp.Aside</span>
                                }
                            </div>
                        }
                        @RenderFactList(grp.Items)
                    </div>
                }
            }
            else if (Facts is { Count: > 0 })
            {
                var (visible, remaining) = ApplyReveal(Facts);
                @RenderFactList(visible)
                @if (remaining > 0)
                {
                    @RenderRevealButton(remaining, Facts.Count)
                }
            }
            else
            {
                <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="display-empty-line">—</p>
            }
        </div>;

    private RenderFragment RenderFactList(IReadOnlyList<DisplayFact> items) =>
        @<dl class="m-0 divide-y divide-(--klyroo-border)">
            @foreach (var fact in items)
            {
                var isEmpty = string.IsNullOrWhiteSpace(fact.Value) && fact.Chip is null;
                var valueColor = fact.Tone is not null ? "text-(--kly-color-text)"
                    : fact.Emphasis ? "text-(--klyroo-text-highlighted)"
                    : "text-(--klyroo-text)";
                <div class="flex items-center justify-between gap-3 py-2 first:pt-0 last:pb-0" data-slot="fact-item">
                    <dt class="flex min-w-0 flex-col gap-0.5 text-xs font-medium text-(--klyroo-text-muted)" data-slot="fact-label">
                        <span class="flex items-center gap-1.5">
                            @if (!string.IsNullOrEmpty(fact.Icon))
                            {
                                @RenderIcon(fact.Icon, "size-3.5 shrink-0")
                            }
                            <span>@fact.Label</span>
                        </span>
                        @if (!string.IsNullOrEmpty(fact.Hint))
                        {
                            <span class="font-normal text-(--klyroo-text-dimmed)" data-slot="fact-hint">@fact.Hint</span>
                        }
                    </dt>
                    <dd class="m-0 flex items-center gap-1.5 text-end @(fact.Mono ? "font-mono" : "") @(fact.Emphasis ? "font-semibold" : "") @valueColor"
                        data-color="@ToneValue(fact.Tone)" data-slot="fact-value">
                        @if (fact.Loading)
                        {
                            <KlySkeleton Class="h-4 w-20" />
                        }
                        else if (fact.Chip is { } chip)
                        {
                            @RenderChip(chip)
                        }
                        else if (isEmpty)
                        {
                            <span class="text-(--klyroo-text-dimmed)" data-slot="fact-empty">—</span>
                        }
                        else if (!string.IsNullOrEmpty(fact.Href))
                        {
                            <a href="@fact.Href" class="text-(--klyroo-primary-text) hover:underline">@fact.Value</a>
                        }
                        else
                        {
                            <span>@fact.Value</span>
                        }
                        @if ((fact.Copy || !string.IsNullOrEmpty(fact.CopyText)) && !isEmpty)
                        {
                            var toCopy = fact.CopyText ?? fact.Value;
                            <button type="button" class="inline-flex size-6 items-center justify-center rounded-(--klyroo-radius) text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text)"
                                    aria-label="@Texts.CopyValue(fact.Label)" data-slot="fact-copy"
                                    @onclick="@(() => CopyToClipboardAsync(toCopy))">
                                @RenderIcon("copy", "size-3.5")
                            </button>
                        }
                    </dd>
                </div>
            }
        </dl>;

    private RenderFragment RenderStat() =>
        @<div class="flex flex-col gap-2" data-slot="display-stat">
            @if (string.Equals(Variant, "row", StringComparison.OrdinalIgnoreCase) && StatItems is { Count: > 0 })
            {
                @if (!string.IsNullOrEmpty(Title))
                {
                    <span class="text-xs font-semibold text-(--klyroo-text-highlighted)" data-slot="stat-row-title">@Title</span>
                }
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3" data-slot="stat-row">
                    @foreach (var item in StatItems)
                    {
                        <div class="flex flex-col gap-0.5" data-slot="stat-item">
                            <span class="text-xs font-medium text-(--klyroo-text-muted)">@item.Label</span>
                            <span class="text-xl font-bold tabular-nums @(item.Tone is null ? "text-(--klyroo-text-highlighted)" : "text-(--kly-color-text)")"
                                  data-color="@ToneValue(item.Tone)" data-slot="stat-item-value">@item.Value</span>
                            @if (!string.IsNullOrEmpty(item.Caption))
                            {
                                <span class="text-xs text-(--klyroo-text-muted)">@item.Caption</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Title))
                {
                    <span class="text-xs font-medium text-(--klyroo-text-muted)" data-slot="stat-label">@Title</span>
                }
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-2xl font-bold tabular-nums text-(--klyroo-text-highlighted)" data-slot="stat-value">@(Value ?? "—")</span>
                        @if (!string.IsNullOrEmpty(Unit))
                        {
                            <span class="text-xs font-medium text-(--klyroo-text-muted)" data-slot="stat-unit">@Unit</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Delta))
                    {
                        var deltaColor = DeltaDirection switch
                        {
                            "down" => KlyColor.Error,
                            "flat" => KlyColor.Neutral,
                            _ => KlyColor.Success,
                        };
                        <KlyBadge Label="@Delta" Color="deltaColor" Variant="KlyVariant.Subtle" Size="KlySize.Sm" data-slot="stat-delta" />
                    }
                </div>
                @if (Trend is { Count: >= 2 })
                {
                    @RenderSparkline(Trend)
                }
                @if (!string.IsNullOrEmpty(Description))
                {
                    <span class="text-xs text-(--klyroo-text-muted)" data-slot="stat-caption">@Description</span>
                }
            }
        </div>;

    private RenderFragment RenderSparkline(IReadOnlyList<double> points)
    {
        var min = points.Min();
        var max = points.Max();
        var range = max - min <= 0 ? 1 : max - min;
        var coords = new List<string>(points.Count);
        for (var i = 0; i < points.Count; i++)
        {
            var x = (i * 100.0 / (points.Count - 1)).ToString("0.#", CultureInfo.InvariantCulture);
            var y = (28.0 - ((points[i] - min) / range * 24.0)).ToString("0.#", CultureInfo.InvariantCulture);
            coords.Add($"{x},{y}");
        }
        var polyline = string.Join(' ', coords);
        return @<svg viewBox="0 0 100 30" class="h-8 w-full overflow-visible text-(--klyroo-primary-text)" data-slot="stat-sparkline" aria-hidden="true">
            <polyline fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="@polyline" />
        </svg>;
    }

    private RenderFragment RenderBreakdown()
    {
        var isCollapsible = string.Equals(Variant, "collapsible", StringComparison.OrdinalIgnoreCase);
        // The comparison layout lines the amounts up in two columns: Value under First, CompareValue under Second.
        var compare = CompareColumns is not null
            || BreakdownLines?.Any(l => l.CompareValue is not null) == true
            || BreakdownTotal?.CompareValue is not null;
        return @<div class="flex flex-col gap-2" data-slot="display-breakdown" data-compare="@(compare ? "true" : null)">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="m-0 font-semibold text-(--klyroo-text-highlighted)">@Title</p>
            }
            @if (isCollapsible)
            {
                <button type="button" class="inline-flex items-center gap-1 self-start text-xs font-medium text-(--klyroo-primary-text) hover:underline"
                        aria-expanded="@(_detailsOpen ? "true" : "false")" data-slot="breakdown-toggle"
                        @onclick="@(() => _detailsOpen = !_detailsOpen)">
                    <span>@(_detailsOpen ? Texts.HideDetails : Texts.Details)</span>
                    @RenderIcon(_detailsOpen ? "chevron-up" : "chevron-down", "size-3.5")
                </button>
            }
            @if (CompareColumns is { } columns && (!isCollapsible || _detailsOpen || BreakdownTotal is not null))
            {
                <div class="grid grid-cols-[minmax(0,1fr)_6rem_6rem] gap-2 text-xs font-medium text-(--klyroo-text-muted)" data-slot="breakdown-columns">
                    <span></span>
                    <span class="text-end">@columns.First</span>
                    <span class="text-end">@columns.Second</span>
                </div>
            }
            @if (!isCollapsible || _detailsOpen)
            {
                @if (BreakdownLines is { Count: > 0 })
                {
                    <div class="flex flex-col gap-1.5" data-slot="breakdown-lines">
                        @foreach (var line in BreakdownLines)
                        {
                            @RenderBreakdownRow(line, "breakdown-line", line.IsSubtotal ? "border-t border-(--klyroo-border) pt-1.5 font-semibold text-(--klyroo-text-highlighted)" : line.IsMuted ? "text-(--klyroo-text-dimmed)" : "", compare)
                        }
                    </div>
                }
            }
            @if (BreakdownTotal is { } total)
            {
                @RenderBreakdownRow(total, "breakdown-total", "border-t border-(--klyroo-border-accented) pt-2 font-semibold text-(--klyroo-text-highlighted)", compare)
            }
            @if (!string.IsNullOrEmpty(Details))
            {
                <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="breakdown-footnote">@Details</p>
            }
        </div>;
    }

    private RenderFragment RenderBreakdownRow(DisplayBreakdownLine line, string slot, string rowClass, bool compare) =>
        @<div class="@(compare ? "grid grid-cols-[minmax(0,1fr)_6rem_6rem] items-baseline gap-2" : "flex items-baseline justify-between gap-2") @rowClass" data-slot="@slot">
            <span class="flex min-w-0 flex-col">
                <span class="inline-flex flex-wrap items-center gap-1.5">
                    <span>@line.Label</span>
                    @if (line.Chip is { } chip)
                    {
                        @RenderChip(chip)
                    }
                </span>
                @if (!string.IsNullOrEmpty(line.Detail))
                {
                    <span class="text-xs font-normal text-(--klyroo-text-muted)" data-slot="breakdown-detail">@line.Detail</span>
                }
            </span>
            <span class="text-end tabular-nums @(line.Tone is null ? "" : "text-(--kly-color-text)")" data-color="@ToneValue(line.Tone)" data-slot="breakdown-value">@(line.Value ?? "—")</span>
            @if (compare)
            {
                <span class="text-end tabular-nums text-(--klyroo-text-muted)" data-slot="breakdown-compare">@(line.CompareValue ?? "—")</span>
            }
        </div>;

    private RenderFragment RenderMeter()
    {
        var max = MeterMax > 0 ? MeterMax : (MeterParts is { Count: > 0 } ? Math.Max(1, MeterParts.Sum(PartAmount)) : 100);
        var val = Math.Clamp(MeterValue, 0, max);
        var pct = Math.Clamp(val / max * 100.0, 0, 100);
        var level = ErrorThreshold is { } err && pct >= err ? "error" : WarningThreshold is { } warn && pct >= warn ? "warning" : "primary";
        var barTone = level switch { "error" => "bg-(--klyroo-error)", "warning" => "bg-(--klyroo-warning)", _ => "bg-(--klyroo-primary)" };
        var ringTone = level switch { "error" => "text-(--klyroo-error)", "warning" => "text-(--klyroo-warning)", _ => "text-(--klyroo-primary)" };
        var isRing = string.Equals(Variant, "ring", StringComparison.OrdinalIgnoreCase);
        var isScale = string.Equals(Variant, "scale", StringComparison.OrdinalIgnoreCase) && MeterLevels is { Count: > 0 };
        var hasParts = MeterParts is { Count: > 0 };
        var showLegend = hasParts && MeterParts!.Any(p => p.ValueLabel is not null || p.Icon is not null || p.Max is not null);
        var valueText = Value ?? $"{val:0.##} / {max:0.##}";

        return @<div class="flex flex-col gap-2" data-slot="display-meter" data-tone="@level">
            @if (isRing)
            {
                <div class="flex items-center gap-4" data-slot="meter-ring">
                    <div class="relative size-20 shrink-0" role="meter" aria-label="@(Title ?? Texts.Meter)"
                         aria-valuenow="@val.ToString("0.##", CultureInfo.InvariantCulture)" aria-valuemin="0"
                         aria-valuemax="@max.ToString("0.##", CultureInfo.InvariantCulture)" aria-valuetext="@valueText">
                        <svg viewBox="0 0 36 36" class="size-full -rotate-90" aria-hidden="true">
                            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="currentColor" stroke-width="3.5" class="text-(--klyroo-bg-muted)" />
                            @if (hasParts)
                            {
                                var offset = 0.0;
                                @foreach (var part in MeterParts!)
                                {
                                    var partPct = Math.Clamp(PartAmount(part) / max * 100.0, 0, 100 - offset);
                                    <circle cx="18" cy="18" r="15.9155" fill="none" stroke="currentColor" stroke-width="3.5"
                                            class="@(part.Tone is null ? "text-(--klyroo-primary)" : "text-(--kly-color)")" data-color="@ToneValue(part.Tone)"
                                            stroke-dasharray="@($"{Num(partPct)} {Num(100 - partPct)}")" stroke-dashoffset="@Num(-offset)"
                                            data-slot="meter-ring-part"><title>@PartTooltip(part)</title></circle>
                                    offset += partPct;
                                }
                            }
                            else if (pct > 0)
                            {
                                <circle cx="18" cy="18" r="15.9155" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"
                                        class="@ringTone" stroke-dasharray="@($"{Num(pct)} {Num(100 - pct)}")" data-slot="meter-ring-value" />
                            }
                        </svg>
                        <span class="absolute inset-0 flex items-center justify-center text-sm font-semibold tabular-nums text-(--klyroo-text-highlighted)"
                              data-slot="meter-value">@(Value ?? $"{Math.Round(pct).ToString(CultureInfo.InvariantCulture)}%")</span>
                    </div>
                    <div class="flex min-w-0 flex-col gap-0.5">
                        @if (!string.IsNullOrEmpty(Title))
                        {
                            <span class="text-xs font-medium text-(--klyroo-text-muted)" data-slot="meter-label">@Title</span>
                        }
                        @if (!string.IsNullOrEmpty(Description))
                        {
                            <span class="text-xs text-(--klyroo-text-muted)" data-slot="meter-caption">@Description</span>
                        }
                    </div>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Value))
                {
                    <div class="flex items-baseline justify-between gap-2">
                        <span class="text-xs font-medium text-(--klyroo-text-muted)" data-slot="meter-label">@Title</span>
                        <span class="text-xs font-semibold tabular-nums text-(--klyroo-text-highlighted)" data-slot="meter-value">@valueText</span>
                    </div>
                }
                @if (isScale)
                {
                    <div class="grid gap-1.5" style="@($"grid-template-columns:repeat({MeterLevels!.Count},minmax(0,1fr))")" data-slot="meter-scale">
                        @for (var i = 0; i < MeterLevels.Count; i++)
                        {
                            var reached = CurrentLevel is { } cur && i <= cur;
                            <div class="rounded-(--klyroo-radius) border px-2 py-1 text-center text-xs font-medium @(reached ? "border-(--klyroo-primary-text) bg-(--klyroo-bg-muted) text-(--klyroo-text-highlighted)" : "border-(--klyroo-border) text-(--klyroo-text-muted)")"
                                 data-slot="meter-level" data-active="@(CurrentLevel == i ? "true" : null)">
                                @MeterLevels[i]
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex h-2.5 w-full overflow-hidden rounded-full bg-(--klyroo-bg-muted)"
                         role="meter" aria-label="@(Title ?? Texts.Meter)"
                         aria-valuenow="@val.ToString("0.##", CultureInfo.InvariantCulture)"
                         aria-valuemin="0"
                         aria-valuemax="@max.ToString("0.##", CultureInfo.InvariantCulture)"
                         data-slot="meter-track">
                        @if (hasParts)
                        {
                            @foreach (var part in MeterParts!)
                            {
                                var partPct = Num(Math.Clamp(PartAmount(part) / max * 100.0, 0, 100));
                                <div class="h-full first:rounded-s-full last:rounded-e-full @(part.Tone is null ? "bg-(--klyroo-primary)" : "bg-(--kly-color)")"
                                     data-color="@ToneValue(part.Tone)" style="@($"width:{partPct}%")" title="@PartTooltip(part)" data-slot="meter-part"></div>
                            }
                        }
                        else
                        {
                            <div class="h-full rounded-full @barTone" style="@($"width:{Num(pct)}%")" data-slot="meter-bar"></div>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(Description))
                {
                    <span class="text-xs text-(--klyroo-text-muted)" data-slot="meter-caption">@Description</span>
                }
            }
            @if (showLegend && !isScale)
            {
                <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-xs" data-slot="meter-legend">
                    @foreach (var part in MeterParts!)
                    {
                        <li class="inline-flex items-center gap-1.5" data-color="@ToneValue(part.Tone)" data-slot="meter-legend-item">
                            @if (!string.IsNullOrEmpty(part.Icon))
                            {
                                @RenderIcon(part.Icon, part.Tone is null ? "size-3.5 text-(--klyroo-primary-text)" : "size-3.5 text-(--kly-color-text)")
                            }
                            else
                            {
                                <span class="size-2 rounded-full @(part.Tone is null ? "bg-(--klyroo-primary)" : "bg-(--kly-color)")" aria-hidden="true"></span>
                            }
                            <span class="text-(--klyroo-text-muted)">@part.Label</span>
                            <span class="font-semibold tabular-nums text-(--klyroo-text-highlighted)">@PartValueText(part)</span>
                        </li>
                    }
                </ul>
            }
        </div>;
    }

    // A part's size on the meter: its value, capped by its own maximum when it has one.
    private static double PartAmount(DisplayMeterPart part) =>
        Math.Max(0, part.Max is { } partMax ? Math.Min(part.Value, partMax) : part.Value);

    private string PartValueText(DisplayMeterPart part) =>
        part.ValueLabel ?? (part.Max is { } partMax
            ? $"{part.Value.ToString("0.##", FormatCulture)} / {partMax.ToString("0.##", FormatCulture)}"
            : part.Value.ToString("0.##", FormatCulture));

    private string PartTooltip(DisplayMeterPart part) => $"{part.Label}: {PartValueText(part)}";

    private static string Num(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private RenderFragment RenderChart() =>
        @<div class="flex flex-col gap-2.5" data-slot="display-chart">
            @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Unit))
            {
                <div class="flex items-baseline justify-between gap-2">
                    <span class="font-semibold text-(--klyroo-text-highlighted)" data-slot="chart-title">@Title</span>
                    @if (!string.IsNullOrEmpty(Unit))
                    {
                        <span class="text-xs text-(--klyroo-text-muted)">@Unit</span>
                    }
                </div>
            }
            @if (ChartData is not { Count: > 0 })
            {
                <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="chart-empty">@Texts.NoData</p>
            }
            else if (string.Equals(Variant, "funnel", StringComparison.OrdinalIgnoreCase))
            {
                var first = Math.Max(1.0, ChartData[0].Value);
                <div class="flex flex-col gap-2" data-slot="chart-funnel">
                    @for (var i = 0; i < ChartData.Count; i++)
                    {
                        var pt = ChartData[i];
                        var widthPct = Math.Clamp(pt.Value / first * 100.0, 4, 100).ToString("0.#", CultureInfo.InvariantCulture);
                        var rate = i > 0 && ChartData[i - 1].Value > 0 ? $"{Math.Round(pt.Value / ChartData[i - 1].Value * 100)}%" : null;
                        <div class="flex flex-col gap-1" data-slot="funnel-step">
                            <div class="flex items-baseline justify-between gap-2 text-xs">
                                <span class="font-medium text-(--klyroo-text)">@pt.Label</span>
                                <span class="tabular-nums text-(--klyroo-text-muted)">@pt.Value @(rate is not null ? $"({rate})" : "")</span>
                            </div>
                            <div class="h-2 rounded-full @ChartFill(pt.Tone)" data-color="@ToneValue(pt.Tone)" style="@($"width:{widthPct}%")"></div>
                        </div>
                    }
                </div>
            }
            else if (string.Equals(Variant, "line", StringComparison.OrdinalIgnoreCase))
            {
                @RenderLineChart(ChartData)
            }
            else
            {
                var max = Math.Max(1.0, ChartData.Max(d => d.Value));
                <div class="flex h-24 items-end gap-2 pt-4" data-slot="chart-bars">
                    @foreach (var pt in ChartData)
                    {
                        var hPct = Math.Clamp(pt.Value / max * 100.0, 6, 100).ToString("0.#", CultureInfo.InvariantCulture);
                        <div class="flex flex-1 flex-col items-center gap-1" title="@($"{pt.Label}: {pt.Value}")" data-slot="chart-bar">
                            <div class="w-full rounded-t-sm @ChartFill(pt.Tone)" data-color="@ToneValue(pt.Tone)" style="@($"height:{hPct}%")"></div>
                            <span class="max-w-full truncate text-[11px] text-(--klyroo-text-muted)">@pt.Label</span>
                        </div>
                    }
                </div>
            }
        </div>;

    private static string ChartFill(KlyColor? tone) => tone is null ? "bg-(--klyroo-primary)" : "bg-(--kly-color)";

    private RenderFragment RenderLineChart(IReadOnlyList<DisplayChartPoint> data)
    {
        // The plot spans from zero (or the lowest negative value) to the highest value; points are spread evenly.
        var max = Math.Max(1.0, data.Max(d => d.Value));
        var min = Math.Min(0.0, data.Min(d => d.Value));
        var range = max - min <= 0 ? 1 : max - min;
        var positions = new List<(double X, double Y)>(data.Count);
        for (var i = 0; i < data.Count; i++)
        {
            var x = data.Count == 1 ? 50.0 : i * 100.0 / (data.Count - 1);
            var y = 100.0 - ((data[i].Value - min) / range * 100.0);
            positions.Add((x, y));
        }
        var polyline = string.Join(' ', positions.Select(p => $"{Num(p.X)},{Num(p.Y)}"));
        return @<div class="flex flex-col gap-1.5 pt-2" data-slot="chart-line">
            <div class="relative h-24">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute inset-0 size-full overflow-visible text-(--klyroo-primary)" aria-hidden="true">
                    <polyline fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                              vector-effect="non-scaling-stroke" points="@polyline" data-slot="chart-line-path" />
                </svg>
                @for (var i = 0; i < data.Count; i++)
                {
                    var pt = data[i];
                    <span class="absolute size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-(--klyroo-bg) @ChartFill(pt.Tone)"
                          data-color="@ToneValue(pt.Tone)" style="@($"left:{Num(positions[i].X)}%;top:{Num(positions[i].Y)}%")"
                          title="@($"{pt.Label}: {pt.Value}")" data-slot="chart-point"></span>
                }
            </div>
            <div class="flex gap-1 @(data.Count == 1 ? "justify-center" : "justify-between")">
                @foreach (var pt in data)
                {
                    <span class="min-w-0 truncate text-[11px] text-(--klyroo-text-muted)">@pt.Label</span>
                }
            </div>
        </div>;
    }

    private RenderFragment RenderTable()
    {
        var cols = TableColumns ?? [];
        var (visibleRows, remaining) = ApplyReveal(TableRows);
        var isSticky = string.Equals(Variant, "sticky", StringComparison.OrdinalIgnoreCase);
        // A sticky header needs a background that hides the rows scrolling under it: the one of the surface.
        var headerBackground = EffectiveSurface switch
        {
            DisplaySurface.Muted => "bg-(--klyroo-bg-muted)",
            DisplaySurface.Elevated => "bg-(--klyroo-bg-elevated)",
            _ => "bg-(--klyroo-bg)",
        };
        return @<div class="flex flex-col gap-2" data-slot="display-table">
            <div class="@(isSticky ? "max-h-80 overflow-auto" : "overflow-x-auto")" data-slot="display-table-scroll">
                <table class="min-w-full text-sm">
                    <thead class="border-b border-(--klyroo-border) text-xs font-semibold text-(--klyroo-text-muted) @(isSticky ? $"sticky top-0 z-10 {headerBackground}" : "")" data-slot="display-table-head">
                        <tr>
                            @foreach (var col in cols)
                            {
                                <th scope="col" class="px-3 py-2 @(col.Numeric || string.Equals(col.Align, "end", StringComparison.OrdinalIgnoreCase) ? "text-end" : "text-start")">@col.Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-(--klyroo-border)">
                        @foreach (var row in visibleRows)
                        {
                            <tr data-slot="display-table-row">
                                @foreach (var col in cols)
                                {
                                    row.TryGetValue(col.Key, out var val);
                                    <td class="px-3 py-2 @(col.Numeric || string.Equals(col.Align, "end", StringComparison.OrdinalIgnoreCase) ? "text-end tabular-nums" : "text-start") @(col.Mono ? "font-mono" : "")">@(val ?? "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    @if (TableFooter is { Count: > 0 })
                    {
                        <tfoot class="border-t border-(--klyroo-border-accented) font-semibold text-(--klyroo-text-highlighted)">
                            <tr>
                                @foreach (var col in cols)
                                {
                                    TableFooter.TryGetValue(col.Key, out var fVal);
                                    <td class="px-3 py-2 @(col.Numeric || string.Equals(col.Align, "end", StringComparison.OrdinalIgnoreCase) ? "text-end tabular-nums" : "text-start")">@fVal</td>
                                }
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
            @if (remaining > 0 && TableRows is not null)
            {
                @RenderRevealButton(remaining, TableRows.Count)
            }
        </div>;
    }

    private RenderFragment RenderDiff()
    {
        var items = (DiffItems ?? []).Where(d => ShowUnchanged || d.Changed).ToList();
        return @<div class="flex flex-col gap-2" data-slot="display-diff">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="m-0 font-semibold text-(--klyroo-text-highlighted)">@Title</p>
            }
            <div class="divide-y divide-(--klyroo-border)">
                @foreach (var item in items)
                {
                    <div class="flex flex-wrap items-center justify-between gap-2 py-2 first:pt-0 last:pb-0" data-slot="diff-item" data-changed="@(item.Changed ? "true" : "false")">
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-(--klyroo-text-muted)">
                            <span>@item.Label</span>
                            @if (item.Note is { } note)
                            {
                                @RenderChip(note)
                            }
                        </span>
                        <div class="flex items-center gap-2 text-xs">
                            @if (item.Changed)
                            {
                                @if (!string.IsNullOrEmpty(item.Before))
                                {
                                    <span class="line-through text-(--klyroo-error-text)" data-slot="diff-before">@item.Before</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Before) && !string.IsNullOrEmpty(item.After))
                                {
                                    <span class="text-(--klyroo-text-muted)" aria-hidden="true">→</span>
                                }
                                <span class="font-semibold text-(--klyroo-success-text)" data-slot="diff-after">@(item.After ?? "—")</span>
                            }
                            else
                            {
                                <span class="text-(--klyroo-text-muted)" data-slot="diff-unchanged">@(item.After ?? item.Before ?? "—")</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>;
    }

    private RenderFragment RenderRecord()
    {
        var (visible, remaining) = ApplyReveal(Records);
        return @<div class="flex flex-col gap-2.5" data-slot="display-record">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="flex items-center justify-between gap-2">
                    <span class="font-semibold text-(--klyroo-text-highlighted)">@Title</span>
                    @if (!string.IsNullOrEmpty(Count))
                    {
                        <span class="text-xs tabular-nums text-(--klyroo-text-muted)">@Count</span>
                    }
                </div>
            }
            @foreach (var rec in visible)
            {
                var secondary = !string.IsNullOrEmpty(rec.Meta) ? rec.Meta : rec.Description;
                <div class="flex items-center justify-between gap-3 py-1.5" data-color="@ToneValue(rec.Tone)" data-slot="record-item">
                    <div class="flex min-w-0 items-center gap-3">
                        @if (!string.IsNullOrEmpty(rec.ImageSrc))
                        {
                            <img src="@rec.ImageSrc" alt="" loading="lazy" class="size-8 shrink-0 rounded-(--klyroo-radius) object-cover" data-slot="record-image" />
                        }
                        else if (!string.IsNullOrEmpty(rec.AvatarText) || !string.IsNullOrEmpty(rec.Icon))
                        {
                            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-(--klyroo-radius) text-xs font-semibold @(rec.Tone is null ? "bg-(--klyroo-bg-muted) text-(--klyroo-text-highlighted)" : "bg-(--kly-color)/15 text-(--kly-color-text)")"
                                  data-slot="record-avatar">
                                @if (!string.IsNullOrEmpty(rec.Icon))
                                {
                                    @RenderIcon(rec.Icon, "size-4")
                                }
                                else
                                {
                                    @rec.AvatarText
                                }
                            </span>
                        }
                        <div class="flex min-w-0 flex-col">
                            @if (!string.IsNullOrEmpty(rec.Reference))
                            {
                                <span class="text-[11px] font-mono text-(--klyroo-text-muted)">@rec.Reference</span>
                            }
                            @if (!string.IsNullOrEmpty(rec.Href))
                            {
                                <a href="@rec.Href" class="truncate font-medium text-(--klyroo-text-highlighted) hover:underline" data-slot="record-title"
                                   @onclick="@(() => OnRecordClickAsync(rec))">@rec.Title</a>
                            }
                            else if (rec.OnClick.HasDelegate)
                            {
                                <button type="button" class="truncate text-start font-medium text-(--klyroo-text-highlighted) hover:underline focus-visible:outline-2 focus-visible:outline-(--klyroo-primary-text)"
                                        data-slot="record-title" @onclick="@(() => OnRecordClickAsync(rec))">@rec.Title</button>
                            }
                            else
                            {
                                <span class="truncate font-medium text-(--klyroo-text-highlighted)" data-slot="record-title">@rec.Title</span>
                            }
                            @if (!string.IsNullOrEmpty(secondary))
                            {
                                <span class="flex min-w-0 items-center gap-1 text-xs text-(--klyroo-text-muted)" data-slot="record-meta">
                                    @if (!string.IsNullOrEmpty(rec.MetaIcon))
                                    {
                                        @RenderIcon(rec.MetaIcon, "size-3 shrink-0")
                                    }
                                    <span class="truncate">@secondary</span>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        @if (rec.Badges is { Count: > 0 })
                        {
                            @foreach (var badge in rec.Badges)
                            {
                                @RenderChip(badge)
                            }
                        }
                        @if (rec.Chip is { } chip)
                        {
                            @RenderChip(chip)
                        }
                        @if (!string.IsNullOrEmpty(rec.Trailing) || !string.IsNullOrEmpty(rec.TrailingCaption))
                        {
                            <div class="flex flex-col items-end">
                                @if (!string.IsNullOrEmpty(rec.Trailing))
                                {
                                    <span class="font-semibold tabular-nums @(rec.Tone is null ? "text-(--klyroo-text-highlighted)" : "text-(--kly-color-text)")" data-slot="record-trailing">@rec.Trailing</span>
                                }
                                @if (!string.IsNullOrEmpty(rec.TrailingCaption))
                                {
                                    <span class="text-xs text-(--klyroo-text-muted)" data-slot="record-trailing-caption">@rec.TrailingCaption</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            @if (remaining > 0 && Records is not null)
            {
                @RenderRevealButton(remaining, Records.Count)
            }
        </div>;
    }

    private static async Task OnRecordClickAsync(DisplayRecordItem record)
    {
        if (record.OnClick.HasDelegate) await record.OnClick.InvokeAsync();
    }

    private RenderFragment RenderPerson() =>
        @<div class="flex flex-col gap-3" data-slot="display-person">
            @if (string.Equals(Variant, "group", StringComparison.OrdinalIgnoreCase) && People is { Count: > 0 })
            {
                var max = Max ?? 4;
                var shown = People.Take(max).ToList();
                var extra = People.Count - shown.Count;
                <div class="flex items-center gap-2" data-slot="person-group">
                    <div class="flex -space-x-2">
                        @foreach (var p in shown)
                        {
                            // The stack has no room for text: the description and the chip go in the tooltip.
                            var tooltip = string.Join(" · ", new[] { p.Name, p.Description, p.Chip?.Label }.Where(s => !string.IsNullOrWhiteSpace(s)));
                            @RenderAvatar(p.Name, p.AvatarSrc, p.Tone, "size-8 border-2 border-(--klyroo-bg)", tooltip)
                        }
                        @if (extra > 0)
                        {
                            <span class="inline-flex size-8 items-center justify-center rounded-full border-2 border-(--klyroo-bg) bg-(--klyroo-bg-elevated) text-xs font-semibold text-(--klyroo-text-muted)"
                                  data-slot="person-overflow">+@extra</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <span class="text-xs text-(--klyroo-text-muted)">@Title</span>
                    }
                </div>
            }
            else
            {
                var single = People is { Count: > 0 } ? People[0] : null;
                // Without People, the person comes from Title, Description and Chip; without a Title it has no name.
                var name = single?.Name ?? (string.IsNullOrWhiteSpace(Title) ? null : Title);
                var description = single is null ? Description : single.Description;
                var chip = single is null ? Chip : single.Chip;
                <div class="flex items-center justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-2.5">
                        @RenderAvatar(name, single?.AvatarSrc, single?.Tone, "size-9 shrink-0", null)
                        <div class="flex min-w-0 flex-col">
                            @if (!string.IsNullOrWhiteSpace(name))
                            {
                                <span class="truncate font-semibold text-(--klyroo-text-highlighted)" data-slot="person-name">@name</span>
                            }
                            @if (!string.IsNullOrEmpty(description))
                            {
                                <span class="truncate text-xs text-(--klyroo-text-muted)" data-slot="person-description">@description</span>
                            }
                        </div>
                    </div>
                    @if (chip is not null)
                    {
                        @RenderChip(chip)
                    }
                </div>
                @if (Contacts is { Count: > 0 })
                {
                    <div class="flex flex-col gap-1.5 border-t border-(--klyroo-border) pt-2" data-slot="person-contacts">
                        @foreach (var c in Contacts)
                        {
                            <div class="flex items-center justify-between gap-2 text-xs" data-slot="person-contact">
                                <span class="flex min-w-0 items-center gap-1.5">
                                    @if (!string.IsNullOrEmpty(c.Icon))
                                    {
                                        @RenderIcon(c.Icon, "size-3.5 shrink-0 text-(--klyroo-text-muted)")
                                    }
                                    @if (!string.IsNullOrEmpty(c.Href))
                                    {
                                        <a href="@c.Href" class="truncate text-(--klyroo-primary-text) hover:underline">@c.Value</a>
                                    }
                                    else
                                    {
                                        <span class="truncate text-(--klyroo-text)">@c.Value</span>
                                    }
                                </span>
                                @if (c.Copy)
                                {
                                    <button type="button" class="inline-flex size-6 items-center justify-center rounded-(--klyroo-radius) text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted)"
                                            aria-label="@Texts.CopyValue(c.Value)" @onclick="@(() => CopyToClipboardAsync(c.Value))">
                                        @RenderIcon("copy", "size-3.5")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>;

    // An image when there is one, else the initials of the name, else a person icon. A tone tints the initials tile.
    private RenderFragment RenderAvatar(string? name, string? src, KlyColor? tone, string sizeClass, string? tooltip) =>
        @<span class="inline-flex items-center justify-center overflow-hidden rounded-full text-xs font-semibold @sizeClass @(tone is null ? "bg-(--klyroo-bg-muted) text-(--klyroo-text-highlighted)" : "bg-(--kly-color)/15 text-(--kly-color-text)")"
               data-color="@ToneValue(tone)" title="@tooltip" data-slot="person-avatar">
            @if (!string.IsNullOrEmpty(src))
            {
                <img src="@src" alt="" loading="lazy" class="size-full object-cover" data-slot="person-image" />
            }
            else if (!string.IsNullOrWhiteSpace(name))
            {
                @InitialsOf(name)
            }
            else
            {
                @RenderIcon("user", "size-4")
            }
        </span>;

    private static string InitialsOf(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private RenderFragment RenderList()
    {
        var (visible, remaining) = ApplyReveal(ListItems);
        var isFiles = string.Equals(Variant, "files", StringComparison.OrdinalIgnoreCase);
        var isSteps = string.Equals(Variant, "steps", StringComparison.OrdinalIgnoreCase);
        var isChecks = string.Equals(Variant, "checks", StringComparison.OrdinalIgnoreCase);
        return @<div class="flex flex-col gap-2" data-slot="display-list">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="m-0 font-semibold text-(--klyroo-text-highlighted)">@Title</p>
            }
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
                @for (var i = 0; i < visible.Count; i++)
                {
                    var idx = i;
                    var item = visible[i];
                    var state = item.Done ? "done" : item.Current ? "current" : "todo";
                    <li class="flex items-center justify-between gap-3" data-slot="list-item" data-state="@(isSteps ? state : null)">
                        <div class="flex min-w-0 items-center gap-2.5">
                            @if (isFiles)
                            {
                                var ext = FilePreviewService.ExtensionLabel(item.FileName ?? item.Text, item.MimeType);
                                <span class="inline-flex h-6 min-w-8 shrink-0 items-center justify-center rounded-(--klyroo-radius) bg-(--klyroo-bg-muted) px-1.5 text-[10px] font-bold uppercase text-(--klyroo-text-highlighted)"
                                      data-slot="file-badge">@ext</span>
                            }
                            else if (isChecks || isSteps)
                            {
                                <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full @(item.Done ? "bg-(--klyroo-success)/15 text-(--klyroo-success-text)" : item.Current ? "bg-(--klyroo-primary) text-(--klyroo-primary-contrast)" : "bg-(--klyroo-bg-muted) text-(--klyroo-text-muted)") text-xs font-semibold">
                                    @if (item.Done)
                                    {
                                        @RenderIcon("check", "size-3")
                                    }
                                    else
                                    {
                                        @(idx + 1)
                                    }
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <span class="inline-flex shrink-0 @(item.Tone is null ? "text-(--klyroo-text-muted)" : "text-(--kly-color-text)")" data-color="@ToneValue(item.Tone)" data-slot="list-icon">
                                    @RenderIcon(item.Icon, "size-4")
                                </span>
                            }
                            else
                            {
                                <span class="size-1.5 shrink-0 rounded-full @(item.Tone is null ? "bg-(--klyroo-text-muted)" : "bg-(--kly-color)")" data-color="@ToneValue(item.Tone)" data-slot="list-bullet"></span>
                            }
                            <div class="flex min-w-0 flex-col">
                                @if (!string.IsNullOrEmpty(item.Href))
                                {
                                    <a href="@item.Href" class="truncate font-medium text-(--klyroo-text-highlighted) hover:underline"
                                       @onclick="@(() => OnFileItemClick(item))" @onclick:preventDefault="@CanPreviewFiles()">@item.Text</a>
                                }
                                else
                                {
                                    <span class="truncate text-(--klyroo-text)">@item.Text</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Description) || item.FileSize is not null)
                                {
                                    <span class="text-xs text-(--klyroo-text-muted)">
                                        @(item.FileSize is { } sz ? FilePreviewService.FormatFileSize(sz, FormatCulture) : item.Description)
                                    </span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Meta))
                        {
                            <span class="shrink-0 text-xs text-(--klyroo-text-muted)">@item.Meta</span>
                        }
                    </li>
                }
            </ul>
            @if (remaining > 0 && ListItems is not null)
            {
                @RenderRevealButton(remaining, ListItems.Count)
            }
        </div>;
    }

    private bool CanPreviewFiles() =>
        RendererInfo.IsInteractive && string.Equals(Variant, "files", StringComparison.OrdinalIgnoreCase)
        && Services.GetService(typeof(FilePreviewService)) is FilePreviewService { IsMounted: true };

    private void OnFileItemClick(DisplayListItem clicked)
    {
        if (!CanPreviewFiles() || ListItems is null) return;
        if (Services.GetService(typeof(FilePreviewService)) is not FilePreviewService preview) return;
        // Only items with an Href are in the gallery, so the clicked item's position is counted among those.
        var linked = ListItems.Where(x => !string.IsNullOrEmpty(x.Href)).ToList();
        var files = linked
            .Select(x => new FilePreviewFile
            {
                Src = x.Href!,
                Name = x.FileName ?? x.Text,
                Mime = x.MimeType,
                Size = x.FileSize,
            })
            .ToList();
        preview.OpenGallery(files, new FilePreviewOptions { Index = Math.Max(0, linked.IndexOf(clicked)) });
    }

    private RenderFragment RenderTimeline()
    {
        if (string.Equals(Variant, "schedule", StringComparison.OrdinalIgnoreCase)) return RenderSchedule();
        var (visible, remaining) = ApplyReveal(TimelineItems);
        var isPipeline = string.Equals(Variant, "pipeline", StringComparison.OrdinalIgnoreCase);
        var isLog = string.Equals(Variant, "log", StringComparison.OrdinalIgnoreCase);
        return @<div class="flex flex-col gap-2" data-slot="display-timeline">
            @if (isLog)
            {
                <ol class="m-0 flex list-none flex-col divide-y divide-(--klyroo-border) p-0 text-xs" data-slot="timeline-log">
                    @foreach (var item in visible)
                    {
                        var state = item.State ?? DisplayTimelineState.Done;
                        <li class="flex items-baseline gap-3 py-1.5 first:pt-0 last:pb-0" aria-current="@(state == DisplayTimelineState.Current ? "step" : null)"
                            data-slot="timeline-item" data-state="@state.ToString().ToLowerInvariant()">
                            <time class="w-32 shrink-0 font-mono tabular-nums text-(--klyroo-text-muted)" datetime="@IsoDate(item.Date)" data-slot="timeline-timestamp">@LogTimestamp(item)</time>
                            <span class="inline-flex shrink-0 self-center @(item.Tone is null ? "text-(--klyroo-text-muted)" : "text-(--kly-color-text)")" data-color="@ToneValue(item.Tone)" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    @RenderIcon(item.Icon, "size-3.5")
                                }
                                else
                                {
                                    <span class="size-1.5 rounded-full bg-current"></span>
                                }
                            </span>
                            <div class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2">
                                <span class="font-medium text-(--klyroo-text-highlighted)" data-slot="timeline-title">@item.Title</span>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="text-(--klyroo-text-muted)">@item.Description</span>
                                }
                                @if (!string.IsNullOrEmpty(item.ActorName))
                                {
                                    <span class="font-medium text-(--klyroo-text-muted)">@item.ActorName</span>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
            else
            {
                <ol class="m-0 flex list-none @(isPipeline ? "flex-row flex-wrap items-center gap-4" : "flex-col gap-3") p-0">
                    @for (var i = 0; i < visible.Count; i++)
                    {
                        var item = visible[i];
                        var state = item.State ?? DisplayTimelineState.Done;
                        var timeText = !string.IsNullOrEmpty(item.Time) ? item.Time : item.Date?.ToString("g", FormatCulture);
                        <li class="flex items-start gap-3" aria-current="@(state == DisplayTimelineState.Current ? "step" : null)" data-slot="timeline-item" data-state="@state.ToString().ToLowerInvariant()">
                            <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full @TimelineMarkerClass(state, item.Tone) text-[11px] font-semibold"
                                  data-color="@ToneValue(item.Tone)" data-slot="timeline-marker">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    @RenderIcon(item.Icon, "size-3")
                                }
                                else
                                {
                                    @(i + 1)
                                }
                            </span>
                            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="font-medium text-(--klyroo-text-highlighted)" data-slot="timeline-title">@item.Title</span>
                                    @if (!string.IsNullOrEmpty(timeText))
                                    {
                                        <time class="text-xs text-(--klyroo-text-muted)" datetime="@IsoDate(item.Date)" data-slot="timeline-time">@timeText</time>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="m-0 text-xs text-(--klyroo-text-muted)">@item.Description</p>
                                }
                                @if (!string.IsNullOrEmpty(item.ActorName))
                                {
                                    <span class="text-xs font-medium text-(--klyroo-text-muted)">@item.ActorName</span>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
            @if (remaining > 0 && TimelineItems is not null)
            {
                @RenderRevealButton(remaining, TimelineItems.Count)
            }
        </div>;
    }

    // The agenda layout: events by day, each with a time column. Events are sorted first and Max cuts the sorted list, so "Show more"
    // reveals later events. An event is listed once, on its first day. Events without a date come last, under their own heading.
    private RenderFragment RenderSchedule()
    {
        var sorted = ScheduleLayout.Sort(TimelineItems);
        var (visible, remaining) = ApplyReveal(sorted);
        var days = ScheduleLayout.Group(visible);
        var today = Now ?? DateTimeOffset.UtcNow;
        var hasDatedDays = days.Any(d => d.Day is not null);
        return @<div class="flex flex-col gap-4" data-slot="display-timeline" data-variant="schedule">
            @foreach (var day in days)
            {
                <div class="flex flex-col gap-1.5" data-slot="schedule-day" data-date="@(day.Day?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))">
                    @if (day.Day is { } date)
                    {
                        <h4 class="m-0 text-xs font-semibold text-(--klyroo-text-highlighted)" data-slot="schedule-day-title">
                            <time datetime="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@ScheduleDayTitle(day, today)</time>
                        </h4>
                    }
                    else if (hasDatedDays)
                    {
                        <h4 class="m-0 text-xs font-semibold text-(--klyroo-text-muted)" data-slot="schedule-unscheduled-title">@Texts.Unscheduled</h4>
                    }
                    <ol class="m-0 flex list-none flex-col gap-1 p-0">
                        @foreach (var e in day.Events)
                        {
                            @RenderScheduleEvent(e)
                        }
                    </ol>
                </div>
            }
            @if (remaining > 0 && TimelineItems is not null)
            {
                @RenderRevealButton(remaining, TimelineItems.Count)
            }
        </div>;
    }

    private RenderFragment RenderScheduleEvent(ScheduleEvent e)
    {
        var item = e.Item;
        var state = item.State;
        var timeText = ScheduleTimeText(e);
        var durationText = ScheduleDurationText(e);
        return @<li class="flex flex-col gap-1 border-s-2 py-1.5 ps-3 sm:flex-row sm:gap-4 @ScheduleRowClass(state, item.Tone)"
                    aria-current="@(state == DisplayTimelineState.Current ? "step" : null)" data-slot="schedule-event"
                    data-state="@(state?.ToString().ToLowerInvariant())" data-color="@ToneValue(item.Tone)">
            <div class="flex shrink-0 flex-row flex-wrap items-baseline gap-x-2 text-xs tabular-nums text-(--klyroo-text-muted) sm:w-40 sm:flex-col sm:gap-x-0 sm:gap-y-0.5" data-slot="schedule-time-column">
                @if (!string.IsNullOrEmpty(timeText))
                {
                    <time class="font-medium text-(--klyroo-text)" datetime="@ScheduleIso(e)" data-slot="schedule-time">@timeText</time>
                }
                @if (!string.IsNullOrEmpty(durationText))
                {
                    <time datetime="@ScheduleLayout.IsoDuration(e)" data-slot="schedule-duration">@durationText</time>
                }
            </div>
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <div class="flex min-w-0 items-center gap-1.5">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <span class="inline-flex shrink-0 @(item.Tone is null ? "text-(--klyroo-text-muted)" : "text-(--kly-color-text)")" aria-hidden="true" data-slot="schedule-icon">@RenderIcon(item.Icon, "size-3.5")</span>
                    }
                    <span class="min-w-0 break-words @(state == DisplayTimelineState.Done ? "font-medium text-(--klyroo-text-muted)" : state == DisplayTimelineState.Current ? "font-semibold text-(--klyroo-text-highlighted)" : "font-medium text-(--klyroo-text-highlighted)")" data-slot="timeline-title">@item.Title</span>
                </div>
                @if (!string.IsNullOrEmpty(item.Description))
                {
                    <p class="m-0 break-words text-xs text-(--klyroo-text-muted)" data-slot="schedule-description">@item.Description</p>
                }
                @if (!string.IsNullOrEmpty(item.ActorName))
                {
                    <span class="text-xs font-medium text-(--klyroo-text-muted)" data-slot="schedule-actor">@item.ActorName</span>
                }
            </div>
        </li>;
    }

    // The left rule of an event: the tone when there is one, else the primary color of the current event and a neutral line for the others.
    private static string ScheduleRowClass(DisplayTimelineState? state, KlyColor? tone) => (state, tone is null) switch
    {
        (DisplayTimelineState.Current, true) => "border-(--klyroo-primary-text) bg-(--klyroo-bg-muted)",
        (DisplayTimelineState.Current, false) => "border-(--kly-color-text) bg-(--klyroo-bg-muted)",
        (DisplayTimelineState.Done, true) => "border-(--klyroo-border)",
        (DisplayTimelineState.Done, false) => "border-(--kly-color-text) opacity-70",
        (_, true) => "border-(--klyroo-border-accented)",
        _ => "border-(--kly-color-text)",
    };

    // "Today" and "Tomorrow" come first when the day is one of them, then the long date of the resolved culture.
    private string ScheduleDayTitle(ScheduleDay day, DateTimeOffset reference)
    {
        var sample = day.Sample!.Value;
        var longDate = sample.ToString("D", FormatCulture);
        var referenceDay = DateOnly.FromDateTime(reference.ToOffset(sample.Offset).DateTime);
        if (day.Day == referenceDay) return $"{Texts.Today} · {longDate}";
        if (day.Day == referenceDay.AddDays(1)) return $"{Texts.Tomorrow} · {longDate}";
        return longDate;
    }

    // The time text wins when given. Otherwise: the all-day label, or the start with the end (and the end date when it is on another day).
    private string ScheduleTimeText(ScheduleEvent e)
    {
        if (!string.IsNullOrEmpty(e.Item.Time)) return e.Item.Time;
        if (e.Start is not { } start) return "";
        if (e.AllDay) return Texts.AllDay;
        var from = start.ToString("t", FormatCulture);
        if (e.End is not { } end) return from;
        var to = end.Date == start.Date ? end.ToString("t", FormatCulture) : $"{end.ToString("d", FormatCulture)} {end.ToString("t", FormatCulture)}";
        return $"{from} – {to}";
    }

    private string ScheduleDurationText(ScheduleEvent e)
    {
        if (e.AllDay) return e.Days > 1 ? Texts.DayCount(e.Days) : "";
        return e.Minutes is { } minutes ? Texts.Duration(minutes) : "";
    }

    private static string? ScheduleIso(ScheduleEvent e) => e.Start is not { } start
        ? null
        : e.AllDay ? start.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : start.ToString("O", CultureInfo.InvariantCulture);

    private static string TimelineMarkerClass(DisplayTimelineState state, KlyColor? tone) => (state, tone is null) switch
    {
        (DisplayTimelineState.Done, true) => "bg-(--klyroo-primary) text-(--klyroo-primary-contrast)",
        (DisplayTimelineState.Done, false) => "bg-(--kly-color) text-(--kly-color-contrast)",
        (DisplayTimelineState.Current, true) => "border-2 border-(--klyroo-primary-text) text-(--klyroo-primary-text)",
        (DisplayTimelineState.Current, false) => "border-2 border-(--kly-color-text) text-(--kly-color-text)",
        (_, true) => "border border-(--klyroo-border) text-(--klyroo-text-muted)",
        _ => "border border-(--kly-color-text) text-(--kly-color-text)",
    };

    // The log line shows the date and the time of each event: from Date, with Time replacing the time part when given.
    private string LogTimestamp(DisplayTimelineItem item)
    {
        if (item.Date is { } date)
        {
            var time = !string.IsNullOrEmpty(item.Time) ? item.Time : date.ToString("t", FormatCulture);
            return $"{date.ToString("d", FormatCulture)} {time}";
        }
        return item.Time ?? "";
    }

    private static string? IsoDate(DateTimeOffset? date) => date?.ToString("O", CultureInfo.InvariantCulture);

    private RenderFragment RenderDate()
    {
        var date = DateValue ?? DateTimeOffset.UtcNow;
        var now = Now ?? DateTimeOffset.UtcNow;
        var days = (int)Math.Round((date.Date - now.Date).TotalDays);
        var isCountdown = string.Equals(Variant, "countdown", StringComparison.OrdinalIgnoreCase);
        var isRange = string.Equals(Variant, "range", StringComparison.OrdinalIgnoreCase) && EndDateValue is not null;
        return @<div class="flex items-center gap-3" data-slot="display-date">
            <div class="flex size-12 shrink-0 flex-col items-center justify-center rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg-muted) text-center" data-slot="date-tile">
                <span class="text-[10px] font-bold uppercase text-(--klyroo-primary-text)">@date.ToString("MMM", FormatCulture)</span>
                <span class="text-base font-bold leading-none tabular-nums text-(--klyroo-text-highlighted)">@date.Day</span>
            </div>
            <div class="flex min-w-0 flex-col gap-0.5">
                <span class="font-semibold text-(--klyroo-text-highlighted)" data-slot="date-title">
                    @if (isCountdown)
                    {
                        @(days == 0 ? Texts.Today : days == 1 ? Texts.Tomorrow : days > 1 ? Texts.InDays(days) : Texts.DaysOverdue(Math.Abs(days)))
                    }
                    else if (isRange)
                    {
                        var end = EndDateValue!.Value;
                        var spanDays = Math.Max(1, (int)Math.Round((end.Date - date.Date).TotalDays) + 1);
                        @($"{date.ToString("yyyy-MM-dd", FormatCulture)} → {end.ToString("yyyy-MM-dd", FormatCulture)} ({Texts.DayCount(spanDays)})")
                    }
                    else
                    {
                        @(Title ?? date.ToString("D", FormatCulture))
                    }
                </span>
                @if ((isCountdown || isRange) && !string.IsNullOrEmpty(Title))
                {
                    <span class="text-xs font-medium text-(--klyroo-text-muted)" data-slot="date-caption">@Title</span>
                }
                @if (!string.IsNullOrEmpty(Description))
                {
                    <span class="text-xs text-(--klyroo-text-muted)">@Description</span>
                }
            </div>
        </div>;
    }

    private RenderFragment RenderMedia() =>
        @<div class="flex flex-col gap-2" data-slot="display-media">
            @if (string.Equals(Variant, "gallery", StringComparison.OrdinalIgnoreCase) && Images is { Count: > 0 })
            {
                var max = Math.Max(1, Max ?? 3);
                var shown = Images.Take(max).ToList();
                var hiddenCount = Images.Count - shown.Count;
                <div class="grid grid-cols-3 gap-2" data-slot="media-gallery">
                    @for (var i = 0; i < shown.Count; i++)
                    {
                        var isLastWithOverflow = i == shown.Count - 1 && hiddenCount > 0;
                        <div class="relative overflow-hidden rounded-(--klyroo-radius) border border-(--klyroo-border)" data-slot="media-tile">
                            <img src="@shown[i]" alt="@(Title ?? Texts.ImageAlt(i + 1))" loading="lazy" class="h-24 w-full object-cover" />
                            @if (isLastWithOverflow)
                            {
                                <span class="absolute inset-0 flex items-center justify-center bg-black/60 text-sm font-bold text-white" data-slot="media-overflow">+@hiddenCount</span>
                            }
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(Src))
            {
                <img src="@Src" alt="@(Title ?? Texts.MediaAlt)" loading="lazy" class="max-h-64 w-full rounded-(--klyroo-radius) object-cover" data-slot="media-image" />
            }
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="media-caption">@Description</p>
            }
        </div>;

    private RenderFragment RenderCode()
    {
        var raw = Value ?? "";
        var isSecret = string.Equals(Variant, "secret", StringComparison.OrdinalIgnoreCase);
        var shown = isSecret && !_secretRevealed ? MaskSecret(raw, VisibleChars) : raw;
        var highlighted = HighlightedCode(raw, isSecret);
        return @<div class="flex flex-col gap-2" data-slot="display-code" data-variant="@(Variant ?? "block")">
            <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold uppercase text-(--klyroo-text-muted)" data-slot="code-label">@(Title ?? Language ?? (isSecret ? Texts.Secret : Texts.Code))</span>
                <div class="flex items-center gap-1">
                    @if (isSecret)
                    {
                        <button type="button" class="inline-flex items-center gap-1 rounded-(--klyroo-radius) px-2 py-1 text-xs font-medium text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text)"
                                aria-pressed="@(_secretRevealed ? "true" : "false")" data-slot="code-secret-toggle"
                                @onclick="@(() => _secretRevealed = !_secretRevealed)">
                            @RenderIcon(_secretRevealed ? "eye-off" : "eye", "size-3.5")
                            <span>@(_secretRevealed ? Texts.Conceal : Texts.Reveal)</span>
                        </button>
                    }
                    @if (Copy)
                    {
                        <button type="button" class="inline-flex items-center gap-1 rounded-(--klyroo-radius) px-2 py-1 text-xs font-medium text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text)"
                                aria-label="@Texts.CopyCode" data-slot="code-copy"
                                @onclick="@(() => CopyToClipboardAsync(raw))">
                            @RenderIcon("copy", "size-3.5")
                        </button>
                    }
                </div>
            </div>
            <pre class="m-0 overflow-x-auto rounded-(--klyroo-radius) bg-(--klyroo-bg-muted) p-3 font-mono text-xs text-(--klyroo-text-highlighted)" data-slot="code-value" data-language="@(highlighted is null ? null : _codeLanguage)"><code>@if (highlighted is null) { @shown } else { @highlighted }</code></pre>
        </div>;
    }

    private string? _codeSource;
    private string? _codeLanguage;
    private RenderFragment? _codeFragment;

    // The highlighted markup of a code, or null for plain text. A secret is never highlighted. The last result is kept so a re-render
    // (a click on the copy button, a parent update) does not scan a large code again.
    private RenderFragment? HighlightedCode(string raw, bool isSecret)
    {
        if (isSecret || !Highlight || !CodeHighlighter.CanHighlight(raw, Language))
        {
            _codeSource = null;
            _codeFragment = null;
            _codeLanguage = null;
            return null;
        }
        var language = CodeHighlighter.ResolveLanguage(Language);
        if (_codeFragment is null || !string.Equals(_codeSource, raw, StringComparison.Ordinal) || _codeLanguage != language)
        {
            _codeSource = raw;
            _codeLanguage = language;
            _codeFragment = CodeRendering.Fragment(CodeHighlighter.Tokenize(raw, language));
        }
        return _codeFragment;
    }

    private static string MaskSecret(string raw, int visible)
    {
        if (string.IsNullOrEmpty(raw)) return "••••••••";
        if (visible <= 0 || raw.Length <= visible) return new string('•', Math.Max(8, raw.Length));
        return new string('•', 8) + raw[^visible..];
    }

    private RenderFragment RenderEmpty() =>
        @<div class="flex flex-col items-center justify-center gap-2 rounded-(--klyroo-radius) border border-dashed border-(--klyroo-border-accented) p-6 text-center" data-slot="display-empty">
            @RenderIcon(!string.IsNullOrEmpty(Icon) ? Icon : "inbox", "size-8 text-(--klyroo-text-muted)")
            <p class="m-0 font-semibold text-(--klyroo-text-highlighted)" data-slot="empty-title">@(Title ?? Texts.NothingToShow)</p>
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="empty-description">@Description</p>
            }
            @if (Actions is { Count: > 0 })
            {
                <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
                    @foreach (var act in Actions)
                    {
                        @RenderAction(act)
                    }
                </div>
            }
        </div>;

    private RenderFragment RenderAccordion() =>
        @<div class="flex flex-col divide-y divide-(--klyroo-border) rounded-(--klyroo-radius) border border-(--klyroo-border)" data-slot="display-accordion">
            @if (AccordionItems is { Count: > 0 })
            {
                @for (var i = 0; i < AccordionItems.Count; i++)
                {
                    var idx = i;
                    var item = AccordionItems[i];
                    var open = _openAccordionIndices.Contains(idx);
                    <div class="flex flex-col" data-slot="accordion-item" data-open="@(open ? "true" : "false")">
                        <button type="button" class="flex min-h-10 w-full items-center justify-between gap-2 px-3.5 py-2 text-start font-medium text-(--klyroo-text-highlighted) hover:bg-(--klyroo-bg-muted)"
                                aria-expanded="@(open ? "true" : "false")" data-slot="accordion-trigger"
                                @onclick="@(() => ToggleAccordion(idx))">
                            <span class="flex items-center gap-2">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    @RenderIcon(item.Icon, "size-4 text-(--klyroo-text-muted)")
                                }
                                <span>@item.Label</span>
                            </span>
                            @RenderIcon(open ? "chevron-up" : "chevron-down", "size-4 text-(--klyroo-text-muted)")
                        </button>
                        @if (open)
                        {
                            <div class="px-3.5 pb-3 pt-1 text-xs text-(--klyroo-text-muted)" role="region" data-slot="accordion-content">
                                @if (item.Template is not null)
                                {
                                    @item.Template
                                }
                                else
                                {
                                    @item.Content
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>;

    private void ToggleAccordion(int index)
    {
        if (_openAccordionIndices.Contains(index))
        {
            _openAccordionIndices.Remove(index);
        }
        else
        {
            if (!Multiple) _openAccordionIndices.Clear();
            _openAccordionIndices.Add(index);
        }
    }

    private RenderFragment RenderAction(DisplayAction act) =>
        @<KlyButton Label="@act.Label" Href="@act.Href" Target="@act.Target" Color="@act.Color" Variant="@act.Variant" Size="KlySize.Sm"
                   LeadingIcon="@(string.IsNullOrEmpty(act.Icon) ? null : RenderIcon(act.Icon, "size-4"))"
                   OnClick="@(() => act.OnClick.InvokeAsync())" data-slot="display-action" />;
}
