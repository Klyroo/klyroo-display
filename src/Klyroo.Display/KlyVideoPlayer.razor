        @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@sizeClass" aria-hidden="true">
            @switch (kind)
            {
                case "play":
                    <polygon points="6 3 20 12 6 21 6 3" />
                    break;
                case "pause":
                    <rect x="14" y="4" width="4" height="16" rx="1" /><rect x="6" y="4" width="4" height="16" rx="1" />
                    break;
                case "lock":
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    break;
