@namespace Klyroo.Display
@using System.Globalization
@using Microsoft.JSInterop
@inherits KlyComponentBase
@implements IAsyncDisposable
@implements IMediaElementHost
@inject IJSRuntime JS

<div @ref="_root" class="@RootClass" role="region" aria-label="@(Title ?? Texts.VideoPlayer)" tabindex="@(Keyboard ? 0 : -1)"
     style="@($"aspect-ratio:{AspectRatio}")"
     data-slot="video-player" data-compact="@(Compact ? "true" : null)" data-locked="@(IsLocked ? "true" : null)" @attributes="AdditionalAttributes">
    <video @ref="_media" src="@Src" poster="@Poster" preload="@Preload" muted="@Muted" playsinline="@PlaysInline"
           loop="@(Loop && !IsRestricted)"
           disablepictureinpicture="@(!Seekable)"
           class="h-full w-full object-contain"
           data-slot="video-element"
           @onclick="TogglePlayAsync">
        @if (Tracks is { Count: > 0 })
        {
            @foreach (var track in Tracks)
            {
                <track src="@track.Src" srclang="@track.SrcLang" label="@track.Label" kind="@track.Kind" default="@track.Default" />
            }
        }
    </video>

    @if (!_playing)
    {
        <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2 bg-black/40 p-4 text-center text-white" data-slot="video-overlay">
            @if (IsLocked)
            {
                <span class="inline-flex size-12 items-center justify-center rounded-full bg-black/70 text-white" data-slot="video-locked-badge">
                    @RenderIcon("lock", "size-5")
                </span>
                <span class="text-sm font-semibold" data-slot="video-locked-text">@Texts.NoPlaysLeft</span>
            }
            else
            {
                <button type="button"
                        class="pointer-events-auto inline-flex size-12 items-center justify-center rounded-full bg-(--klyroo-primary) text-(--klyroo-primary-contrast) shadow-md hover:opacity-95 disabled:opacity-40"
                        disabled="@Disabled"
                        aria-label="@Texts.PlayVideo"
                        data-slot="video-start"
                        @onclick="TogglePlayAsync">
                    @RenderIcon("play", "size-5")
                </button>
                @if (MaxPlays > 0)
                {
                    <span class="rounded-full bg-black/65 px-2.5 py-0.5 text-xs font-medium tabular-nums" data-slot="video-plays-badge">
                        @Texts.PlaysLeft(RemainingPlays)
                    </span>
                }
            }
        </div>
    }

    <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-center bg-gradient-to-t from-black/80 via-black/50 to-transparent text-white @(Compact ? "gap-1.5 px-2 pb-1.5 pt-4" : "gap-2.5 px-3 pb-2.5 pt-6")" data-slot="media-controls">
        @if (IsLocked)
        {
            <span class="inline-flex items-center gap-1.5 text-xs font-medium" data-slot="media-locked">
                @RenderIcon("lock", "size-4")
                <span>@Texts.NoPlaysLeft</span>
            </span>
            <span class="ms-auto font-mono text-xs tabular-nums" data-slot="media-time">
                @KlyAudioPlayer.FormatTime(ClipPosition) / @KlyAudioPlayer.FormatTime(ClipLength)
            </span>
        }
        else
        {
            <button type="button"
                    class="inline-flex @(Compact ? "size-7" : "size-8") shrink-0 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 disabled:opacity-40"
                    disabled="@Disabled"
                    aria-label="@(_playing ? Texts.Pause : Texts.Play)"
                    data-slot="media-play"
                    @onclick="TogglePlayAsync">
                @RenderIcon(_playing ? "pause" : "play", Compact ? "size-3.5" : "size-4")
            </button>

            @if (!IsHidden(MediaPlayerControl.Time))
            {
                <span class="shrink-0 font-mono text-xs tabular-nums text-white/90" data-slot="media-time">
                    @KlyAudioPlayer.FormatTime(ClipPosition) / @KlyAudioPlayer.FormatTime(ClipLength)
                </span>
            }

            <div class="flex @(Compact ? "min-w-16" : "min-w-24") flex-1 items-center" data-slot="media-timeline">
                @if (Seekable)
                {
                    <input type="range" min="0" max="@ClipLength.ToString("0.##", CultureInfo.InvariantCulture)"
                           step="0.1" value="@ClipPosition.ToString("0.##", CultureInfo.InvariantCulture)"
                           disabled="@Disabled"
                           aria-label="@Texts.Seek"
                           class="h-1.5 w-full cursor-pointer accent-(--klyroo-primary)"
                           data-slot="media-seek"
                           @oninput="OnSeekInputAsync" />
                }
                else
                {
                    var pct = ClipLength > 0 ? Math.Clamp(ClipPosition / ClipLength * 100.0, 0, 100) : 0;
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/25"
                         role="progressbar" aria-label="@Texts.PlaybackProgress"
                         aria-valuenow="@Math.Round(pct)" aria-valuemin="0" aria-valuemax="100"
                         data-slot="media-progress">
                        <div class="h-full bg-(--klyroo-primary)" style="@($"width:{pct.ToString("0.#", CultureInfo.InvariantCulture)}%")"></div>
                    </div>
                }
            </div>

            @if (MaxPlays > 0)
            {
                <span class="inline-flex items-center gap-1 rounded-full bg-white/15 px-2 py-0.5 text-[11px] font-semibold tabular-nums"
                      title="@Texts.PlaysLeft(RemainingPlays)" data-slot="media-plays-left">
                    @RemainingPlays
                </span>
            }

            @if (!IsHidden(MediaPlayerControl.Volume))
            {
                <button type="button"
                        class="inline-flex @(Compact ? "size-6" : "size-7") items-center justify-center rounded-full text-white/90 hover:bg-white/15"
                        aria-label="@(Muted ? Texts.Unmute : Texts.Mute)"
                        aria-pressed="@(Muted ? "true" : "false")"
                        disabled="@Disabled"
                        data-slot="media-mute"
                        @onclick="ToggleMuteAsync">
                    @RenderIcon(Muted ? "volume-x" : "volume-2", "size-4")
                </button>
                <input type="range" min="0" max="1" step="0.05"
                       value="@Volume.ToString("0.##", CultureInfo.InvariantCulture)"
                       aria-label="@Texts.Volume"
                       class="h-1.5 @(Compact ? "w-14" : "w-20") shrink-0 cursor-pointer accent-(--klyroo-primary)"
                       disabled="@Disabled"
                       data-slot="media-volume"
                       @oninput="OnVolumeInputAsync" />
            }

            @if (!IsHidden(MediaPlayerControl.Rate) && Rates is { Count: > 1 })
            {
                <button type="button"
                        class="inline-flex @(Compact ? "h-6" : "h-7") items-center justify-center rounded-full px-2 text-xs font-semibold tabular-nums text-white/90 hover:bg-white/15"
                        aria-label="@Texts.PlaybackSpeed"
                        data-slot="media-rate"
                        @onclick="CycleRateAsync">
                    @($"{Rate.ToString("0.##", CultureInfo.InvariantCulture)}×")
                </button>
            }

            @if (!IsHidden(MediaPlayerControl.Captions) && Tracks is { Count: > 0 })
            {
                <button type="button"
                        class="inline-flex @(Compact ? "h-6" : "h-7") items-center justify-center rounded-full px-2 text-xs font-semibold text-white/90 hover:bg-white/15"
                        aria-label="@Texts.Captions"
                        aria-pressed="@(_activeTrackIndex >= 0 ? "true" : "false")"
                        data-slot="media-captions"
                        @onclick="CycleCaptions">
                    CC
                </button>
            }

            @if (!IsHidden(MediaPlayerControl.PictureInPicture) && _pictureInPictureSupported && Seekable)
            {
                <button type="button"
                        class="inline-flex @(Compact ? "size-6" : "size-7") items-center justify-center rounded-full text-white/90 hover:bg-white/15"
                        aria-label="@Texts.PictureInPicture"
                        aria-pressed="@(_pictureInPicture ? "true" : "false")"
                        data-slot="media-pip"
                        @onclick="TogglePictureInPictureAsync">
                    @RenderIcon("picture-in-picture", "size-4")
                </button>
            }

            @if (!IsHidden(MediaPlayerControl.Fullscreen) && _fullscreenSupported)
            {
                <button type="button"
                        class="inline-flex @(Compact ? "size-6" : "size-7") items-center justify-center rounded-full text-white/90 hover:bg-white/15"
                        aria-label="@(_fullscreen ? Texts.ExitFullscreen : Texts.Fullscreen)"
                        aria-pressed="@(_fullscreen ? "true" : "false")"
                        data-slot="media-fullscreen"
                        @onclick="ToggleFullscreenAsync">
                    @RenderIcon(_fullscreen ? "minimize" : "maximize", "size-4")
                </button>
            }

            @if (!IsHidden(MediaPlayerControl.Download) && (Download || !string.IsNullOrEmpty(DownloadUrl)))
            {
                <a href="@(DownloadUrl ?? Src)" download="@KlyAudioPlayer.DownloadName(DownloadFileName, DownloadUrl ?? Src)"
                   class="inline-flex @(Compact ? "size-6" : "size-7") items-center justify-center rounded-full text-white/90 hover:bg-white/15"
                   aria-label="@Texts.Download" data-slot="media-download"
                   @onclick="OnDownloadClickAsync">
                    @RenderIcon("download", "size-4")
                </a>
            }
        }
    </div>
</div>

@code {
    private bool _playing;
    private bool _playActive;
    private double _currentTime;
    private ElementReference _media;
    private ElementReference _root;
    private DisplayTexts? _texts;
    private bool _tracksInitialized;
    private bool _pictureInPictureSupported;
    private bool _fullscreenSupported;
    private bool _pictureInPicture;
    private bool _fullscreen;
    private MediaElementInterop? _interop;
    private double? _mediaDuration;
    private bool _pauseMedia;
    private string? _loadedSrc;
    private int _activeTrackIndex = -1;

    /// <summary>The URL of the media file.</summary>
    [Parameter] public required string Src { get; set; }
    /// <summary>The poster image shown before the video plays.</summary>
    [Parameter] public string? Poster { get; set; }
    /// <summary>The accessible name of the player region.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>The CSS <c>aspect-ratio</c> of the player (<c>"16 / 9"</c> by default).</summary>
    [Parameter] public string AspectRatio { get; set; } = "16 / 9";
    /// <summary>The <c>preload</c> attribute of the media element (<c>"metadata"</c> by default).</summary>
    [Parameter] public string Preload { get; set; } = "metadata";
    /// <summary>Starts playing once the player is interactive. Browsers can refuse to start a player that is not muted before the user has interacted with the page; the player then stays paused.</summary>
    [Parameter] public bool Autoplay { get; set; }
    /// <summary>Sets <c>loop</c> on the media element. It is ignored when the player is restricted by <see cref="MaxPlays"/> or by <see cref="Seekable"/> being <see langword="false"/>.</summary>
    [Parameter] public bool Loop { get; set; }
    /// <summary>Sets <c>playsinline</c> on the video element (<see langword="true"/> by default).</summary>
    [Parameter] public bool PlaysInline { get; set; } = true;
    /// <summary>Disables the play, seek, mute and volume controls, and the methods that drive them.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Renders a denser control bar: less padding and spacing, smaller buttons and a shorter volume slider.</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>Whether the focused player reacts to keys: Space or K toggles playback, M toggles mute (<see langword="true"/> by default). Only keys pressed while the player itself has the focus count: a key on one of its buttons or sliders is left to that control.</summary>
    [Parameter] public bool Keyboard { get; set; } = true;

    /// <summary>The clip start, in seconds. Positions and durations are reported relative to it.</summary>
    [Parameter] public double Start { get; set; }
    /// <summary>The clip end, in seconds. It is used when it is greater than <see cref="Start"/>, otherwise <see cref="Duration"/> gives the end.</summary>
    [Parameter] public double? End { get; set; }
    /// <summary>The total duration in seconds, used until the media element reports its own (<c>60</c> by default). Set <see cref="End"/> to stop before the end of the file.</summary>
    [Parameter] public double Duration { get; set; } = 60;
    /// <summary>Whether the user can move the position with the timeline. When <see langword="false"/> the timeline is a read-only progress bar (<see langword="true"/> by default).</summary>
    [Parameter] public bool Seekable { get; set; } = true;
    /// <summary>The number of times the clip can be started (<c>0</c>, the default, means unlimited). Once <see cref="Plays"/> reaches it and the current play ends, the player locks and shows that no plays are left.</summary>
    [Parameter] public int MaxPlays { get; set; }

    /// <summary>The number of plays already used. The component increments it when a play starts and raises <see cref="PlaysChanged"/>: keep the value in your own state and pass it back, so a re-render does not lose it.</summary>
    [Parameter] public int Plays { get; set; }
    /// <summary>Raised with the new count when a play starts.</summary>
    [Parameter] public EventCallback<int> PlaysChanged { get; set; }

    /// <summary>The playback rate shown on the speed button (<c>1.0</c> by default).</summary>
    [Parameter] public double Rate { get; set; } = 1.0;
    /// <summary>Raised with the new rate when the speed button is clicked.</summary>
    [Parameter] public EventCallback<double> RateChanged { get; set; }

    /// <summary>The rates the speed button cycles through. The button is hidden when there are fewer than two (0.5, 0.75, 1, 1.25, 1.5 and 2 by default).</summary>
    [Parameter] public IReadOnlyList<double>? Rates { get; set; } = [0.5, 0.75, 1, 1.25, 1.5, 2];

    /// <summary>The volume of the media element, from 0 to 1 (<c>1.0</c> by default). The volume slider changes it and raises <see cref="VolumeChanged"/>.</summary>
    [Parameter] public double Volume { get; set; } = 1.0;
    /// <summary>Raised with the new volume, from 0 to 1, when the volume slider moves or <see cref="SetVolumeAsync"/> is called.</summary>
    [Parameter] public EventCallback<double> VolumeChanged { get; set; }

    /// <summary>Whether the player is muted. The mute button toggles it and raises <see cref="MutedChanged"/>.</summary>
    [Parameter] public bool Muted { get; set; }
    /// <summary>Raised with the new value when the mute button is clicked.</summary>
    [Parameter] public EventCallback<bool> MutedChanged { get; set; }

    /// <summary>Shows the download link (<see langword="false"/> by default). The link also shows when <see cref="DownloadUrl"/> is set.</summary>
    [Parameter] public bool Download { get; set; }
    /// <summary>The target of the download link. When <see langword="null"/>, <see cref="Src"/> is used.</summary>
    [Parameter] public string? DownloadUrl { get; set; }
    /// <summary>The file name suggested to the browser by the download link. When <see langword="null"/>, the last segment of the link URL is used, or the browser picks a name for a <c>data:</c> or <c>blob:</c> URL.</summary>
    [Parameter] public string? DownloadFileName { get; set; }

    /// <summary>The caption tracks, rendered as <c>track</c> elements. The track marked <see cref="VideoPlayerTrack.Default"/> is shown first; the CC button then cycles through the tracks and off, showing the selected track and disabling the others. The choice is kept across renders and starts over when <see cref="Src"/> changes.</summary>
    [Parameter] public IReadOnlyList<VideoPlayerTrack>? Tracks { get; set; }
    /// <summary>The controls to remove from the control bar. <see cref="MediaPlayerControl.Volume"/> removes the mute button and the volume slider.</summary>
    [Parameter] public IReadOnlyList<MediaPlayerControl>? Hide { get; set; }

    /// <summary>Raised when playback starts or resumes.</summary>
    [Parameter] public EventCallback OnPlay { get; set; }
    /// <summary>Raised when the user pauses.</summary>
    [Parameter] public EventCallback OnPause { get; set; }
    /// <summary>Raised when the position reaches the end of the clip.</summary>
    [Parameter] public EventCallback OnEnded { get; set; }
    /// <summary>Raised when no plays are left: when a play ends with <see cref="Plays"/> at <see cref="MaxPlays"/>, and each time a play is requested while the player is locked (from the keyboard, a media key or <see cref="TogglePlayAsync"/>).</summary>
    [Parameter] public EventCallback OnLimitReached { get; set; }
    /// <summary>Raised with the position during playback, about four times a second, and when the user seeks.</summary>
    [Parameter] public EventCallback<MediaPlayerProgress> OnTimeUpdate { get; set; }
    /// <summary>Raised when the download link is clicked.</summary>
    [Parameter] public EventCallback OnDownload { get; set; }

    /// <summary>The number of plays left, or <see cref="int.MaxValue"/> when <see cref="MaxPlays"/> is zero.</summary>
    public int RemainingPlays => MaxPlays > 0 ? Math.Max(0, MaxPlays - Plays) : int.MaxValue;
    /// <summary>Whether the player is locked: <see cref="MaxPlays"/> is set, no plays are left and no play is in progress.</summary>
    public bool IsLocked => MaxPlays > 0 && RemainingPlays <= 0 && !_playActive;
    private bool IsRestricted => MaxPlays > 0 || !Seekable;
    /// <summary>The clip end in seconds: <see cref="End"/> when it is greater than <see cref="Start"/>, otherwise <see cref="Duration"/>.</summary>
    public double ClipEnd => End is { } e && e > Start ? e : Math.Max(Start, _mediaDuration ?? Duration);
    /// <summary>The clip length in seconds, <see cref="ClipEnd"/> minus <see cref="Start"/>.</summary>
    public double ClipLength => Math.Max(0, ClipEnd - Start);
    /// <summary>The position inside the clip in seconds, between zero and <see cref="ClipLength"/>.</summary>
    public double ClipPosition => Math.Clamp(_currentTime - Start, 0, ClipLength);

    private DisplayTexts Texts => _texts ??= Options.Extension<DisplayTexts>();

    private string RootClass =>
        $"relative overflow-hidden rounded-(--klyroo-radius-md) bg-black text-white shadow-sm {Class}".Trim();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_loadedSrc is not null && _loadedSrc != Src)
        {
            // A new file: the element reloads and stops, so the play in progress ends without spending anything more.
            _playing = false;
            _playActive = false;
            _mediaDuration = null;
            _currentTime = Start;
            // A new file comes with its own tracks: select its default track again.
            _tracksInitialized = false;
        }
        _loadedSrc = Src;
        if (_currentTime < Start) _currentTime = Start;
        if (Disabled && _playing)
        {
            _playing = false;
            _pauseMedia = true;
        }
        if (!_tracksInitialized && Tracks is { Count: > 0 })
        {
            // Only once: afterwards the CC button owns the choice, including turning the captions off.
            _tracksInitialized = true;
            _activeTrackIndex = -1;
            for (var i = 0; i < Tracks.Count; i++)
            {
                if (Tracks[i].Default) { _activeTrackIndex = i; break; }
            }
        }
        if (_activeTrackIndex >= (Tracks?.Count ?? 0)) _activeTrackIndex = -1;
    }

    /// <inheritdoc />
    protected override void OnInitialized() => _interop = new MediaElementInterop(this);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_interop is null) return;
        if (firstRender)
        {
            await _interop.AttachAsync(JS, _media, _root, MediaOptions);
            // Parameters may have changed while the module loaded.
            await _interop.UpdateAsync(MediaOptions);
            if (Autoplay) await TogglePlayAsync();
            return;
        }
        await _interop.UpdateAsync(MediaOptions);
        if (_pauseMedia)
        {
            _pauseMedia = false;
            await _interop.PauseAsync();
        }
    }

    private MediaElementOptions MediaOptions =>
        new(Start, End is { } end && end > Start ? end : null, Loop && !IsRestricted, Muted, Rate, Volume, _activeTrackIndex, Keyboard);

    async Task IMediaElementHost.OnMediaTimeUpdateAsync(double time)
    {
        if (!_playing) return;
        _currentTime = time;
        await OnTimeUpdate.InvokeAsync(new MediaPlayerProgress(ClipPosition, ClipLength, _currentTime));
        StateHasChanged();
    }

    async Task IMediaElementHost.OnMediaEndedAsync()
    {
        if (_playActive) await CompletePlayAsync();
    }

    Task IMediaElementHost.OnMediaDurationAsync(double duration)
    {
        _mediaDuration = duration;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Playback started or paused outside the player's buttons, for example with a hardware media key.
    async Task IMediaElementHost.OnMediaPlayingChangedAsync(bool playing)
    {
        if (playing == _playing) return;
        await TogglePlayAsync();
        if (playing && !_playing && _interop is not null) await _interop.PauseAsync();
    }

    Task IMediaElementHost.OnMediaPlayFailedAsync()
    {
        _playing = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    Task IMediaElementHost.OnMediaKeyAsync(string key) => HandleKeyAsync(key);

    Task IMediaElementHost.OnMediaCapabilitiesAsync(bool pictureInPicture, bool fullscreen)
    {
        _pictureInPictureSupported = pictureInPicture;
        _fullscreenSupported = fullscreen;
        StateHasChanged();
        return Task.CompletedTask;
    }

    Task IMediaElementHost.OnMediaFullscreenChangedAsync(bool fullscreen)
    {
        _fullscreen = fullscreen;
        StateHasChanged();
        return Task.CompletedTask;
    }

    Task IMediaElementHost.OnMediaPictureInPictureChangedAsync(bool active)
    {
        _pictureInPicture = active;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_interop is not null) await _interop.DisposeAsync();
        _interop = null;
    }

    /// <summary>Starts, resumes or pauses the player, as the play button does. Starting a new play consumes one of <see cref="MaxPlays"/>. It does nothing when <see cref="Disabled"/>, and only raises <see cref="OnLimitReached"/> when <see cref="IsLocked"/>.</summary>
    public async Task TogglePlayAsync()
    {
        if (Disabled) return;
        if (IsLocked)
        {
            await OnLimitReached.InvokeAsync();
            return;
        }
        if (_playing)
        {
            _playing = false;
            if (_interop is not null) await _interop.PauseAsync();
            await OnPause.InvokeAsync();
            StateHasChanged();
            return;
        }

        double? from = null;
        if (!_playActive)
        {
            _playActive = true;
            _currentTime = Start;
            Plays++;
            await PlaysChanged.InvokeAsync(Plays);
            from = Start;
        }

        _playing = true;
        if (_interop is not null) await _interop.PlayAsync(from);
        await OnPlay.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>Moves the position to an offset inside the clip, raises <see cref="OnTimeUpdate"/>, and ends the play when the offset reaches the clip end. It does nothing unless <see cref="Seekable"/>, and when <see cref="Disabled"/> or <see cref="IsLocked"/>.</summary>
    /// <param name="clipOffsetSeconds">The offset in seconds from <see cref="Start"/>, clamped to the clip.</param>
    /// <returns>A task that completes when the callbacks have run.</returns>
    public async Task SeekAsync(double clipOffsetSeconds)
    {
        if (!Seekable || Disabled || IsLocked) return;
        var clamped = Math.Clamp(clipOffsetSeconds, 0, ClipLength);
        _currentTime = Start + clamped;
        var reachesEnd = _currentTime >= ClipEnd - 0.05 && ClipLength > 0;
        if (reachesEnd && _playing)
        {
            // Pause first, so the element does not also report the end while OnTimeUpdate runs.
            _playing = false;
            if (_interop is not null) await _interop.PauseAsync();
        }
        if (_interop is not null) await _interop.SeekAsync(_currentTime);
        await OnTimeUpdate.InvokeAsync(new MediaPlayerProgress(ClipPosition, ClipLength, _currentTime));
        if (_currentTime >= ClipEnd - 0.05 && ClipLength > 0)
        {
            await CompletePlayAsync();
            return;
        }
        StateHasChanged();
    }

    /// <summary>Ends the current play: stops, moves the position to the clip end, and raises <see cref="OnEnded"/> and, when no plays are left, <see cref="OnLimitReached"/>. The player calls it when the media reaches the clip end.</summary>
    public async Task CompletePlayAsync()
    {
        _playing = false;
        _playActive = false;
        _currentTime = ClipEnd;
        if (_interop is not null) await _interop.PauseAsync();
        await OnEnded.InvokeAsync();
        if (MaxPlays > 0 && Plays >= MaxPlays)
        {
            await OnLimitReached.InvokeAsync();
        }
        StateHasChanged();
    }

    /// <summary>Toggles <see cref="Muted"/> and raises <see cref="MutedChanged"/>. It does nothing when <see cref="Disabled"/>.</summary>
    public async Task ToggleMuteAsync()
    {
        if (Disabled) return;
        Muted = !Muted;
        await MutedChanged.InvokeAsync(Muted);
        StateHasChanged();
    }

    /// <summary>Sets <see cref="Volume"/>, as the volume slider does, and raises <see cref="VolumeChanged"/>.</summary>
    /// <param name="volume">The new volume, clamped between 0 and 1.</param>
    /// <returns>A task that completes when the callback has run.</returns>
    public async Task SetVolumeAsync(double volume)
    {
        if (Disabled) return;
        var clamped = double.IsNaN(volume) ? Volume : Math.Clamp(volume, 0, 1);
        if (clamped.Equals(Volume)) return;
        Volume = clamped;
        await VolumeChanged.InvokeAsync(Volume);
        StateHasChanged();
    }

    /// <summary>
    /// Opens the video in the browser's picture-in-picture window, or closes that window, as the picture-in-picture button does.
    /// The browser refuses it without a recent user gesture, when it does not support picture-in-picture, and when
    /// <see cref="Seekable"/> is <see langword="false"/> (the element then has <c>disablepictureinpicture</c>).
    /// </summary>
    /// <returns>A task that completes when the request has been sent to the browser.</returns>
    public async Task TogglePictureInPictureAsync()
    {
        if (!Seekable || _interop is null) return;
        await _interop.TogglePictureInPictureAsync();
    }

    /// <summary>Shows the player fullscreen, or leaves fullscreen, as the fullscreen button does. The browser refuses it without a recent user gesture.</summary>
    /// <returns>A task that completes when the request has been sent to the browser.</returns>
    public async Task ToggleFullscreenAsync()
    {
        if (_interop is null) return;
        await _interop.ToggleFullscreenAsync();
    }

    /// <summary>Selects the next entry of <see cref="Rates"/> (wrapping around), and raises <see cref="RateChanged"/>. It does nothing with fewer than two rates.</summary>
    public async Task CycleRateAsync()
    {
        if (Rates is not { Count: > 1 }) return;
        var idx = -1;
        for (var i = 0; i < Rates.Count; i++)
        {
            if (Math.Abs(Rates[i] - Rate) < 0.001) { idx = i; break; }
        }
        Rate = Rates[(idx + 1) % Rates.Count];
        await RateChanged.InvokeAsync(Rate);
        StateHasChanged();
    }

    private void CycleCaptions()
    {
        if (Tracks is not { Count: > 0 }) return;
        _activeTrackIndex = _activeTrackIndex + 1 >= Tracks.Count ? -1 : _activeTrackIndex + 1;
    }

    private async Task OnSeekInputAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var pos))
        {
            await SeekAsync(pos);
        }
    }

    private async Task OnVolumeInputAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var volume))
        {
            await SetVolumeAsync(volume);
        }
    }

    // The media module reports keys pressed on the player root only, so a key on a focused button is not handled twice.
    private async Task HandleKeyAsync(string key)
    {
        if (!Keyboard) return;
        if (key is " " or "k" or "K") await TogglePlayAsync();
        else if (key is "m" or "M") await ToggleMuteAsync();
    }

    private async Task OnDownloadClickAsync()
    {
        if (OnDownload.HasDelegate) await OnDownload.InvokeAsync();
    }

    private bool IsHidden(MediaPlayerControl control) =>
        Hide is not null && Hide.Contains(control);

