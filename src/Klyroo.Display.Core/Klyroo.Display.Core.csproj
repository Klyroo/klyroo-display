<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Display</RootNamespace>
    <PackageId>Klyroo.Display.Core</PackageId>
    <PackageTags>klyroo;display;file-preview;csv;syntax-highlighting;headless;nativeaot</PackageTags>
    <Description>Klyroo Display Core: Headless file preview service, MIME/extension kind detector, RFC 4180 CSV parser, and media rule models. Zero UI dependency, NativeAOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Klyroo.Display" />
    <InternalsVisibleTo Include="Klyroo.Display.Tests" />
  </ItemGroup>
</Project>
