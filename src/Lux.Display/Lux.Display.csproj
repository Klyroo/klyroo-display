<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lux.Display</RootNamespace>
    <PackageId>Lux.Display</PackageId>
    <Description>LuxStack Display blocks (19 kinds), Audio/Video players with clip rules, and FilePreview overlay provider for Blazor Web &amp; .NET MAUI Hybrid.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;BL0007</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lux.Display.Core\Lux.Display.Core.csproj" />
    <ProjectReference Include="..\..\..\lux-ui\src\Lux.UI\Lux.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <SupportedPlatform Include="ios" />
    <SupportedPlatform Include="android" />
    <SupportedPlatform Include="maccatalyst" />
    <SupportedPlatform Include="windows" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Lux.UI" />
  </ItemGroup>
</Project>
