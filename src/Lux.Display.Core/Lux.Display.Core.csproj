<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.Tools</RootNamespace>
    <PackageId>Lux.Display.Core</PackageId>
    <Description>LuxStack Display Core: Headless file preview service, MIME/extension kind detector, RFC 4180 CSV parser, and media rule models. Zero UI dependency, NativeAOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lux.Display" />
    <InternalsVisibleTo Include="Lux.Display.Tests" />
  </ItemGroup>
</Project>
